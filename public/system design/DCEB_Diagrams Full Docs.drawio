d alt text"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=15;" vertex="1" parent="ixc8"><mxGeometry x="290.0" y="258.0" width="262.0" height="38.0" as="geometry"/></mxCell></object><object id="ix_F15" label="F15  Privacy request and security incident" link="data:page/id,pg_F15" tooltip="What the church does when a person asks about their data, and when something goes wrong"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=15;" vertex="1" parent="ixc8"><mxGeometry x="562.0" y="258.0" width="262.0" height="38.0" as="geometry"/></mxCell></object><mxCell id="ixc9_p" value="Phase 1 · Foundations. Data-flow diagrams (Gane-Sarson): context, level 1 and level 2." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="ixc9"><mxGeometry x="18.0" y="34.0" width="806.0" height="30.0" as="geometry"/></mxCell><object id="ix_D01" label="D01  Context diagram (level 0)" link="data:page/id,pg_D01" tooltip="The whole system as one bubble: who talks to it and what they exchange"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.2;align=left;verticalAlign=middle;spacing=4;rounded=1;arcSize=15;" vertex="1" parent="ixc9"><mxGeometry x="18.0" y="74.0" width="262.0" height="38.0" as="geometry"/></mxCell></object><object id="ix_D02" label="D02  Level 1: the system split into nine processes" link="data:page/id,pg_D02" tooltip="Process 0 opened up: nine numbered processes, nine data stores, and who talks to whom"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSiz