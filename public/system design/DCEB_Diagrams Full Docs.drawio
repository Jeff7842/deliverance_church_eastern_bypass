lign=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1030.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_NewMemberJourney_newmember" value="New member: CRU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1058.5" width="110.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewMemberJourney_super" value="Super: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="168.0" y="1058.5" width="61.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewMemberJourney_discipler" value="Discipler: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="237.7" y="1058.5" width="75.6" height="22.0" as="geometry"/></mxCell><mxCell id="acc_NewMemberProfile" value="&lt;b&gt;Who may do what on NewMemberProfile   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1120.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_NewMemberProfile_newmember" value="New member: CRU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1148.5" width="110.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewMemberProfile_super" value="Super: RX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="168.0" y="1148.5" width="68.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewMemberProfile_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="244.4" y="1148.5" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewMemberProfile_discipler" value="Discipler: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="320.2" y="1148.5" width="75.6" height="22.0" as="geometry"/></mxCell><mxCell id="n1_NewMemberJourney" value="&lt;b style=&quot;font-size:11px&quot;&gt;NewMemberJourney – in plain words&lt;/b&gt;&lt;br&gt;A bookmark that remembers where the newcomer is in the tour.&lt;br&gt;The server-side memory of one person's tour, created ONLY after they&lt;br&gt;say Yes and give consent. &quot;No&quot; is remembered on their device only." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1210.5" width="337.3" height="174.0" as="geometry"/></mxCell><mxCell id="n2_NewMemberJourney" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• No server record for "No, thanks": it lives in localStorage (+ cookie if&lt;br&gt;cookies accepted).&lt;br&gt;• deviceId is a random id from the browser, stored hashed; progress&lt;br&gt;survives a refresh.&lt;br&gt;• Abandoned journeys older than 90 days are anonymised.&lt;br&gt;• Created ONLY after the visitor says Yes and accepts consent. "No"&lt;br&gt;never reaches the server.&lt;br&gt;• Stores progress as currentStep + completedSteps so a refresh&lt;br&gt;resumes where they left.&lt;br&gt;• Anonymous token in an httpOnly cookie links the browser to the&lt;br&gt;journey until contact details are given.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1210.5" width="337.3" height="174.0" as="geometry"/></mxCell><mxCell id="n3_NewMemberJourney" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Saving data before consent. A "No" must leave no trace on the server.&lt;br&gt;• Asking all nine steps at once on one long page: people leave. One&lt;br&gt;short step at a time.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1210.5" width="337.3" height="174.0" as="geometry"/></mxCell><mxCell id="n1_NewMemberProfile" value="&lt;b style=&quot;font-size:11px&quot;&gt;NewMemberProfile – in plain words&lt;/b&gt;&lt;br&gt;The newcomer's &quot;about me&quot; card.&lt;br&gt;What the newcomer tells us about themselves in the tour." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1406.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_NewMemberProfile" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• born-again fields are sensitive belief data: collected only with explicit&lt;br&gt;consent and shown only to Disciplers.&lt;br&gt;• If wantsToBeBornAgain is true, a Convert + FollowUpCase are created&lt;br&gt;in the same transaction.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1406.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_NewMemberProfile" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Making every field mandatory. Only name, age group and branch are&lt;br&gt;required; everything else is optional.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1406.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Journey = where the person is in the tour. Profile = what they told us about themselves.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1512.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B44  ·  Tab: New-member journey and profile&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="journeyId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.5;endArrow=none;endFill=0;startArrow=diamondThin;startFill=1;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_NewMemberJourney" target="c_NewMemberProfile"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge0_s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge0_d" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBa