or=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="989.0" width="85.4" height="22.0" as="geometry"/></mxCell><mxCell id="sv_1" value="CacheService" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="143.4" y="989.0" width="87.6" height="22.0" as="geometry"/></mxCell><mxCell id="acc_LedgerEntry" value="&lt;b&gt;Who may do what on LedgerEntry   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1047.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_LedgerEntry_super" value="Super: RX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1075.0" width="68.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_LedgerEntry_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="126.3" y="1075.0" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_LedgerEntry_treasurer" value="Treasurer: CRUX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FAF1D9;strokeColor=#A16207;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="202.1" y="1075.0" width="100.0" height="22.0" as="geometry"/></mxCell><mxCell id="acc_GivingChannel" value="&lt;b&gt;Who may do what on GivingChannel   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1137.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_GivingChannel_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1165.0" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_GivingChannel_newmember" value="New member: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1165.0" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_GivingChannel_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="225.9" y="1165.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_GivingChannel_branch" value="Branch: RA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="317.2" y="1165.0" width="75.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_GivingChannel_treasurer" value="Treasurer: CRU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FAF1D9;strokeColor=#A16207;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="400.2" y="1165.0" width="93.4" height="22.0" as="geometry"/></mxCell><mxCell id="n1_LedgerEntry" value="&lt;b style=&quot;font-size:11px&quot;&gt;LedgerEntry – in plain words&lt;/b&gt;&lt;br&gt;A line in the church's cash book.&lt;br&gt;One gift recorded by the treasurer. The ONLY source of truth for the&lt;br&gt;progress bars." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1227.0" width="337.3" height="148.0" as="geometry"/></mxCell><mxCell id="n2_LedgerEntry" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Append-only: mistakes are VOIDED with a reason, never edited or&lt;br&gt;deleted.&lt;br&gt;• amountMinor &amp;gt; 0 (CHECK).&lt;br&gt;• donorLabel defaults to "Anonymous"; the church sees only what it&lt;br&gt;needs.&lt;br&gt;• source = manual today; "gateway" is the reserved slot for&lt;br&gt;M-Pesa/Paystack later, so no schema change is needed.&lt;br&gt;• Every insert and void writes AuditLog and recomputes&lt;br&gt;Project.raisedAmountMinor.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1227.0" width="337.3" height="148.0" as="geometry"/></mxCell><mxCell id="n3_LedgerEntry" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Editing the total on the project instead of adding a ledger row. Then&lt;br&gt;nobody can explain the number.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1227.0" width="337.3" height="148.0" as="geometry"/></mxCell><mxCell id="n1_GivingChannel" value="&lt;b style=&quot;font-size:11px&quot;&gt;GivingChannel – in plain words&lt;/b&gt;&lt;br&gt;The church's payment addresses.&lt;br&gt;The &quot;how to give&quot; details shown on the contact page and on each&lt;br&gt;project: paybill, till, bank, international." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1397.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_GivingChannel" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Changing a paybill number or bank account is a high-risk edit:&lt;br&gt;two-person approval (Treasurer proposes, Branch Admin confirms) and&lt;br&gt;an email alert.&lt;br&gt;• projectId set = shown on that project page too.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1397.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_GivingChannel" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Letting any editor change account numbers. This is the #1&lt;br&gt;church-website fraud target.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1397.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="gnote" value="&lt;b style=&quot;font-size:11px&quot;&gt;How this group fits together&lt;/b&gt;&lt;br&gt;GivingChannel = where to give (M-Pesa Paybill, bank). LedgerEntry = the treasurer's record of money received for a project; append-only." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1503.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B42  ·  Tab: Ledger and giving channels&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id