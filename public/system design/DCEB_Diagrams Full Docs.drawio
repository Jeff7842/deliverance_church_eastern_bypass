ze=15;" vertex="1" parent="1"><mxGeometry x="33.0" y="174.0" width="210.0" height="64.0" as="geometry"/></mxCell><mxCell id="c1" value="Staff page (/admin)?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="38.0" y="284.0" width="200.0" height="38.0" as="geometry"/></mxCell><mxCell id="c1y" value="No pop-ups at all on staff pages" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="12.0" y="368.0" width="186.0" height="32.0" as="geometry"/></mxCell><mxCell id="c2" value="Cookie choice already saved?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="234.0" y="368.0" width="218.0" height="66.0" as="geometry"/></mxCell><mxCell id="c2n" value="Show the cookie bar at the bottom&lt;br&gt;(Accept all / Only needed / Choose).&lt;br&gt;It does not block the page." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="151.0" y="480.0" width="210.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="Load analytics only if the visitor&lt;br&gt;accepted analytics. Until then&lt;br&gt;PostHog stays off." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="256.0" y="590.0" width="184.0" height="64.0" as="geometry"/></mxCell><mxCell id="d1" value="Tour answer saved on this device?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240.0" y="700.0" width="216.0" height="66.0" as="geometry"/></mxCell><mxCell id="d2" value="Wait for a calm moment: 5 seconds&lt;br&gt;on the page, or the first scroll. Never&lt;br&gt;on top of a form or a video." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="279.0" y="812.0" width="210.0" height="64.0" as="geometry"/></mxCell><mxCell id="d3" value='Modal 1: "Are you new here? Take a&lt;br&gt;tour?"  [Yes] [No]' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="279.0" y="922.0" width="210.0" height="48.0" as="geometry"/></mxCell><mxCell id="d4" value="Yes or No?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="327.0" y="1016.0" width="114.0" height="38.0" as="geometry"/></mxCell><mxCell id="d5" value='Save "No" on this device&lt;br&gt;(localStorage, and a cookie if&lt;br&gt;cookies were accepted). Nothing&lt;br&gt;goes to the server.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="279.0" y="1100.0" width="192.0" height="78.0" as="geometry"/></mxCell><mxCell id="d6" value="Start the tour (F06). The newsletter&lt;br&gt;question waits until the tour ends or&lt;br&gt;is skipped." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="507.0" y="1107.0" width="206.0" height="64.0" as="geometry"/></mxCell><mxCell id="e1" value="Newsletter answer saved or&lt;br&gt;subscribed?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="207.0" y="1224.0" width="210.0" height="66.0" as="geometry"/></mxCell><mxCell id="e2" value="Has the visitor scrolled past the About&lt;br&gt;section?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490.0" y="1336.0" width="222.0" height="94.0" as="geometry"/></mxCell><mxCell id="e3" value='Modal 2: "Get our newsletter?"&lt;br&gt;e-mail, language, branch &lt;br&gt;[Subscribe] [No thanks]' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="474.0" y="1476.0" width="180.0" height="64.0" as="geometry"/></mxCell><mxCell id="e4" value="Subscribe?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="506.0" y="1586.0" width="116.0" height="38.0" as="geometry"/></mxCell><mxCell id="e5" value="Double opt-in e-mail (F13)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="296.0" y="1678.0" width="156.0" height="32.0" as="geometry"/></mxCell><mxCell id="e6" value='Save "No thanks" on this device.&lt;br&gt;Ask again only after 90 days.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="488.0" y="1670.0" width="190.0" height="48.0" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="364.0" y="1764.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;F02  ·  First visit: cookie bar and the order of the pop-ups&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="12.0" y="-66.0" width="700.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value='Flow and block diagrams   |   New-member question first, newsletter question second, and "No" remembered   |   Phase 1' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="12.0" y="-36.0" width="700.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing