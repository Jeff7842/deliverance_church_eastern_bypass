geometry"><mxPoint x="150.0" y="688.0" as="sourcePoint"/><mxPoint x="345.0" y="688.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg9" value='10. limit("like:" + ipHash, 20 per minute)' style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355.0" y="734.0" as="sourcePoint"/><mxPoint x="550.0" y="734.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg10" value="allowed" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#64748B;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550.0" y="768.0" as="sourcePoint"/><mxPoint x="355.0" y="768.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg11" value="12. INSERT or DELETE like(sermonId, deviceHash)  (unique)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355.0" y="802.0" as="sourcePoint"/><mxPoint x="960.0" y="802.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg12" value="13. INCR / DECR sermon:ID:likes" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355.0" y="836.0" as="sourcePoint"/><mxPoint x="755.0" y="836.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg13" value="new count" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#64748B;strokeWidth=1.4;rounded=0;curved=0;endArrow=ope