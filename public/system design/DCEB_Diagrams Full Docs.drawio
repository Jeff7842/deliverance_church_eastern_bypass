4155;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="108.9" y="923.0" width="77.0" height="22.0" as="geometry"/></mxCell><mxCell id="acc_NewsletterSubscriber" value="&lt;b&gt;Who may do what on NewsletterSubscriber   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="981.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_NewsletterSubscriber_visitor" value="Visitor: S" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1009.0" width="63.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewsletterSubscriber_newmember" value="New member: S" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="121.7" y="1009.0" width="95.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewsletterSubscriber_super" value="Super: RUDX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="224.8" y="1009.0" width="82.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewsletterSubscriber_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="315.5" y="1009.0" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewsletterSubscriber_editor" value="Editor: RUDX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="391.3" y="1009.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="acc_NewsletterCampaign" value="&lt;b&gt;Who may do what on NewsletterCampaign   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1071.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_NewsletterCampaign_super" value="Super: CRUDP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1099.0" width="90.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NewsletterCampaign_editor" value="Editor: CRUDP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="148.0" y="1099.0" width="90.6" height="22.0" as="geometry"/></mxCell><mxCell id="n1_NewsletterSubscriber" value='&lt;b style="font-size:11px"&gt;NewsletterSubscriber – in plain words&lt;/b&gt;&lt;br&gt;A name on the mailing list.&lt;br&gt;Someone who gave their email in the popup or footer.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1161.0" width="337.3" height="136.0" as="geometry"/></mxCell><mxCell id="n2_NewsletterSubscriber" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Double opt-in: status stays pending until they click the email link.&lt;br&gt;• Every email carries a one-click unsubscribe; bounces and complaints&lt;br&gt;from Resend update status via webhook.&lt;br&gt;• Never email minors flagged in a form.&lt;br&gt;• Double opt-in: status pending until the link in the confirmation e-mail is&lt;br&gt;clicked.&lt;br&gt;• Every e-mail carries a one-click unsubscribe link (token).&lt;br&gt;• Subscribers are per branch or "all branches".' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1161.0" width="337.3" height="136.0" as="geometry"/></mxCell><mxCell id="n3_NewsletterSubscriber" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Adding people from the contact form to the newsletter without asking.&lt;br&gt;It is illegal under the Kenya Data Protection Act consent rule and gets&lt;br&gt;your domain blocked.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1161.0" width="337.3" height="136.0" as="geometry"/></mxCell><mxCell id="n1_NewsletterCampaign" value='&lt;b style="font-size:11px"&gt;NewsletterCampaign – in plain words&lt;/b&gt;&lt;br&gt;One newsletter issue.&lt;br&gt;One email sent to the list (weekly digest or special message).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1319.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_NewsletterCampaign" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• A campaign is a draft -&amp;gt; scheduled -&amp;gt; sending -&amp;gt; sent record; sending&lt;br&gt;is done in batches by QStash so Resend limits are respected.&lt;br&gt;• Test-send to yourself is mandatory before "schedule".' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1319.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_NewsletterCampaign" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Sending 2000 emails in one loop inside a request: it times out half&lt;br&gt;way. Use batches.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1319.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Subscribers confirm by e-mail (double opt-in). Campaigns are sent by Resend in batches.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1413.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B47  ·  Tab: Newsletter&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="pg_B48" name="B48 Tab: Contact, consent, notification log"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="1716" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_ContactMessage" value="ContactMessage" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=29;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#4338CA;strokeColor=#4338CA;swimlaneFillColor=#FFFFFF;strokeWidth=1