"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg_U06" name="U06 Administration: Super Admin, Branch Admin and Treasurer"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1102" pageHeight="1258" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bnd" value="&lt;b&gt;DCEB admin area: administration&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#475569;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;dashed=1;dashPattern=6 4;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260.0" y="150.0" width="802.0" height="958.0" as="geometry"/></mxCell><mxCell id="branch" value="Branch Admin&lt;br&gt;(one branch)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40.0" y="515.0" width="76.0" height="86.0" as="geometry"/></mxCell><mxCell id="treasurer" value="Treasurer" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FAF1D9;strokeColor=#A16207;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40.0" y="635.0" width="76.0" height="72.0" as="geometry"/></mxCell><mxCell id="super" value="Super Admin&lt;br&gt;(global)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40.0" y="741.0" width="76.0" height="86.0" as="geometry"/></mxCell><mxCell id="howto" value='&lt;b style="font-size:11px"&gt;How to read this page&lt;/b&gt;&lt;br&gt;• A stick figure is a PERSON or an outside SERVICE that uses the system.&lt;br&gt;• An oval is one thing they can do (a use case).&lt;br&gt;• A grey frame groups ovals. A line from an actor to a frame means the actor takes part in EVERY oval inside it. A line to one oval means&lt;br&gt;only that oval.&lt;br&gt;• A dashed purple arrow means "this oval always uses that one" (include) or "may add this step" (extend).&lt;br&gt;• The dashed outline is the edge of our website; anything outside it is not ours.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1138.0" width="640.0" height="112.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;U06  ·  Administration: Super Admin, Branch Admin and Treasurer&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="72.0" width="872.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="UML: use cases   |   Who can change structure, projects, money, roles and the whole system   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="102.0" width="872.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent