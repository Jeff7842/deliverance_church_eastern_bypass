=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=2.5600000000000005;align=center;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1650.0" y="319.0" width="200.0" height="32.0" as="geometry"/></mxCell><mxCell id="ts" value="Cloudflare Turnstile" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=2.5600000000000005;align=center;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1650.0" y="449.0" width="200.0" height="32.0" as="geometry"/></mxCell><mxCell id="rs" value="Resend (e-mail)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=2.5600000000000005;align=center;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1650.0" y="943.0" width="200.0" height="32.0" as="geometry"/></mxCell><mxCell id="sms" value="Africa's Talking (SMS)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=2.5600000000000005;align=center;verticalAlign=middle;spacing=6;rounded=0;" vertex="1" parent="1"><mxGeometry x="1650.0" y="995.0" width="200.0" height="32.0" as="geometry"/></mxCell><mxCell id="gnote0" value="Only the main store of each process is drawn on this&lt;br&gt;page. The other stores each process reads are drawn on&lt;br&gt;its own level-2 page (D03 to D10), and the&lt;br&gt;process-by-store table is on D11." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="1890.0" y="140.0" width="270.0" height="70.0" as="geometry"/></mxCell><mxCell id="gnote1" value="Redis (cache, counters, rate limits) is not a store here: it&lt;br&gt;only holds copies that can be rebuilt (see E13 and F04).&lt;br&gt;PostHog and YouTube talk to the visitor's browser, so&lt;br&gt;they appear on D04." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="1890.0" y="224.0" width="270.0" height="70.0" as="geometry"/></mxCell><mxCell id="gnote2" value="Every process also writes one line to the audit log (D8)&lt;br&gt;when staff change something; those arrows are left out&lt;br&gt;to keep the page readable and are drawn on D10." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="1890.0" y="308.0" width="270.0" height="58.0" as="geometry"/></mxCell><mxCell id="gnote3" value="Process 9 has no person beside it: it runs by schedule&lt;br&gt;(QStash) or when another process asks it to send&lt;br&gt;something." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="1890.0" y="380.0" width="270.0" height="58.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;D02  ·  Level 1: the system split into nine processes&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="180.0" y="62.0" width="1830.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Data flow   |   Process 0 opened up: nine numbered processes, nine data stores, and who talks to whom   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="180.0" y="92.0" width="1830.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="2050.0" y="66.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="drafts, edits, approvals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;startFill=0;exitX=1.000;exitY=0.317;exitDx=0;exitDy=0;entryX=0.000;entryY=0.382;entryDx=0;entryDy=0;" edge="1" parent="1" source="editor" target="P1"><mxGeometry x="0.000" relative="1" as="geometry"><mxPoint x="0.0" y="-11.2" as="offset"/></mxGeometry></mxCell><mxCell id="edge1" value="previews, status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;startFill=0;exitX=0.000;exitY=0.618;exitDx=0;exitDy=0;entryX=1.000;entryY=0.683;entryDx=0;entryDy=0;" edge="1" parent="1" source="P1" target="editor"><mxGeometry x="0.000" relative="1" as="geometry"><mxPoint x="0.0" y="11.2" as="offset"/></mxGeometry></mxCell><mxCell id="edge2" value="reviewed translations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;startFil