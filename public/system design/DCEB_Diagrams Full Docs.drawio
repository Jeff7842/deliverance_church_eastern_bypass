ontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="317.2" y="941.5" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Leader_editor" value="Editor: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="414.7" y="941.5" width="69.4" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Leader_translator" value="Translator: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FDEEE3;strokeColor=#C2410C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="492.1" y="941.5" width="88.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Leader_dept" value="Dept leader: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="589.0" y="941.5" width="87.8" height="22.0" as="geometry"/></mxCell><mxCell id="acc_LeaderPosition" value="&lt;b&gt;Who may do what on LeaderPosition   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1003.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_LeaderPosition_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1031.5" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_LeaderPosition_newmember" value="New member: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1031.5" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_LeaderPosition_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="225.9" y="1031.5" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_LeaderPosition_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="317.2" y="1031.5" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_LeaderPosition_dept" value="Dept leader: CRU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E5F4EA;strokeColor=#15803D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="414.7" y="1031.5" width="102.2" height="22.0" as="geometry"/></mxCell><mxCell id="n1_Leader" value="&lt;b style=&quot;font-size:11px&quot;&gt;Leader – in plain words&lt;/b&gt;&lt;br&gt;A leader's public profile card.&lt;br&gt;A person shown publicly as a pastor, elder or leader. NOT a login (that&lt;br&gt;is User) and NOT a sermon speaker record (that is Minister)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1093.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_Leader" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Email and phone are private unless showContact = true.&lt;br&gt;• userId is optional: most leaders never log in.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1093.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_Leader" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Merging Leader, Minister and User into one "person" table. They&lt;br&gt;overlap but have different privacy and life-cycles.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1093.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_LeaderPosition" value="&lt;b style=&quot;font-size:11px&quot;&gt;LeaderPosition – in plain words&lt;/b&gt;&lt;br&gt;A job on a leader's CV, with a start date.&lt;br&gt;&quot;When they became what, and what they hold.&quot; One leader has many&lt;br&gt;positions over time; history is kept, not overwritten." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1187.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n2_LeaderPosition" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• endedOn null means current.&lt;br&gt;• A position is scoped to church, one branch, or one department&lt;br&gt;(CHECK).&lt;br&gt;• Never edit a past position to record a promotion; end it and add a new&lt;br&gt;one.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1187.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n3_LeaderPosition" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• A single "title" text column on Leader. You lose the history and the&lt;br&gt;"since when".' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1187.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;A Leader is a person. A LeaderPosition is "this person holds this title in this department from this date to that date", so history ("when they became what") is kept.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1307.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B24  ·  Tab: Leader and LeaderPosition&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="leaderId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;startFill=0;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.200;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_StaffProfile" target="c_Leader"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="718.0" y="189.8"/><mxPoint x="718.0" y="299.2"/></Array></mxGeometry></mxCell><mxCell id="edge0_s" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge0_d" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeomet