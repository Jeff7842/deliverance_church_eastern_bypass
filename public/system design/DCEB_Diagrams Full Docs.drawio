Age, sessionsPerCohort, … +11&lt;br&gt;Project  adds: goalAmountMinor, currency, raisedAmountMinor, status, … +10' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#D91E2A;strokeWidth=1.6;align=left;verticalAlign=top;spacing=8;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="12.0" y="201.5" width="640.0" height="138.0" as="geometry"/></mxCell><mxCell id="famReq" value='&lt;b style="font-size:11px"&gt;PersonRequest family (4 classes)&lt;/b&gt;&lt;br&gt;EventRegistration  adds: eventId, ticketCode, attendeesCount, guardianName, … +2&lt;br&gt;ProgrammeEnrollment  adds: cohortId, origin, convertId, guardianName, … +3&lt;br&gt;Convert  adds: decisionAt, origin, outreachId, capturedBy, … +7&lt;br&gt;JoinRequest  adds: kind, departmentId, homeFellowshipId, journeyId, … +3' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6F4F1;strokeColor=#0F766E;strokeWidth=1.6;align=left;verticalAlign=top;spacing=8;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="974.0" y="253.5" width="520.0" height="86.0" as="geometry"/></mxCell><mxCell id="famBase" value='&lt;b style="font-size:11px"&gt;Plain BaseEntity children (31 tables)&lt;/b&gt;&lt;br&gt;Branch · ServiceTime · Department · Leader · LeaderPosition · HomeFellowship · Minister · Topic · Comment ·&lt;br&gt;MediaAsset · PageBlock · TimelineEntry · EventGuest · EventSession · ProgrammeCohort · FollowUpCase ·&lt;br&gt;ProjectMilestone · ProjectUpdate · LedgerEntry · GivingChannel · FormDefinition · FormField ·&lt;br&gt;NewMemberJourney · NewMemberProfile · FeedbackResponse · Certificate · NewsletterSubscriber ·&lt;br&gt;NewsletterCampaign · ContactMessage · ConsentRecord · NotificationLog' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#EEF1F5;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacing=8;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1102.0" y="654.0" width="520.0" height="100.0" as="geometry"/></mxCell><mxCell id="famAlone" value='&lt;b style="font-size:11px"&gt;Stand-alone (own id rules: 14)&lt;/b&gt;&lt;br&gt;User · Session · Account · Verification · StaffProfile · RoleAssignment · AuditLog ·&lt;br&gt;MemberAccount · SermonTopic · Like · SiteSetting · OutreachDepartment ·&lt;br&gt;ContactAttempt · ProjectMedia&lt;br&gt;(Better Auth tables use text ids; link tables use a two-column primary key.)' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.6;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacing=8;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="232.0" y="28.8" width="420.0" height="86.0" as="geometry"/></mxCell><mxCell id="c_Event" value="Event" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=29;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#BE185D;strokeColor=#BE185D;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="688.0" y="210.8" width="250.0" height="119.5" as="geometry"/></mxCell><mxCell id="c_Event_a0" value="+ id: uuid {PK}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Event"><mxGeometry x="0.0" y="33.0" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_Event_a1" value="+ departmentId: uuid {FK→Department}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Event"><mxGeometry x="0.0" y="49.5" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_Event_a2" value="+ formId: uuid {FK→FormDefinition}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Event"><mxGeometry x="0.0" y="66.0" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_Event_a3" value="+ category: EventCategory" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Event"><mxGeometry x="0.0" y="82.5" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_Event_a4" value="… +18 more" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Event"><mxGeometry x="0.0" y="99.0" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_OutreachActivity" value="OutreachActivity" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=29;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#BE185D;strokeColor=#BE185D;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="688.0" y="12.0" width="250.0" height="119.5" as="geometry"/></mxCell><mxCell id="c_OutreachActivity_a0" value="+ id: uuid {PK}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_OutreachActivity"><mxGeometry x="0.0" y="33.0" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_OutreachActivity_a1" value="+ outreachCategory: OutreachCategory" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_OutreachActivity"><mxGeometry x="0.0" y="49.5" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_OutreachActivity_a2" value="+ country: text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_OutreachActivity"><mxGeometry x="0.0" y="66.0" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_OutreachActivity_a3" value="+ locationName: text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_OutreachActivity"><mxGeometry x="0.0" y="82.5" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_OutreachActivity_a4" value="… +5 more" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_OutreachActivity"><mxGeometry x="0.0" y="99.0" width="250.0" height="16.5" as="geometry"/></mxCell><mxCell id="note_cti" value="Two ways to inherit in a database. (1) &quot;Shared columns&quot;: every child table repeats the&lt;br&gt;parent's columns (Sermon has id, created_at, slug, status ...). (2) &quot;Class-table inheritance&quot;:&lt;br&gt;the child table only holds its OWN columns and shares the parent's id (OutreachActivity is&lt;br&gt;a row in event AND a row in outreach_activity). We use (1) for the three abstract parents&lt;br&gt;and (2) once, for OutreachActivity." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="974.0" y="30.8" width="420.0" height="82.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B02  ·  What inherits what&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="12.0" y="-66.0" width="1460.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class architecture (UML)   |   One parent gives the same columns and the same life-cycle to many children   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="12.0" y="-36.0" width="1460.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1512.0" y="-62.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=0;startArrow=none;startFill=0;exitX=0.503;exitY=1.000;exitDx=0;exitDy=0;entryX=0.250;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_Publishable" target="c_BaseEntity"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="786.0" y="770.0"/><mxPoint x="950.0" y="770.0"/></Array></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=0;startArrow=none;startFill=0;exitX=0.503;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_PersonRequest" target="c_BaseEntity"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=0;startArrow=none;startFill=0;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.750;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="famBase" target="c_BaseEntity"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1362.0" y="770.0"/><mxPoint x="1020.0" y="770.0"/></Array></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=0;startArrow=none;startFill=0;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.331;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="famPub" target="c_Publishable"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="332.0" y="355.5"/><mxPoint x="758.0" y="355.5"/></Array></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=0;startArrow=none;startFill=0;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.669;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_Event" target="c_Publishable"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=0;startArrow=none;startFill=0;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.503;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="famReq" target="c_PersonRequest"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1234.0" y="355.5"/><mxPoint x="985.0" y="355.5"/></Array></mxGeometry></mxCell><mxCell id="edge6" value="class-table inheritance (shares the primary key)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=0;startArrow=none;startFill=0;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_OutreachActivity" target="c_Event"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg_B03" name="B03 Layers: who may call whom"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L1" value="&lt;b&gt;Layer 1 · Browser (what the visitor sees)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#0F766E;fillColor=#E6F4F1;strokeColor=#0F766E;strokeWidth=2.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260.0" y="130.0" width="1360.0" height="84.0" as="geometry"/></mxCell><mxCell id="L2" value="&lt;b&gt;Layer 2 · Entry points (the doors into the server)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#0369A1;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=2.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260.0" y="284.0" width="1360.0" height="84.0" as="geometry"/></mxCell><mxCell id="L3" value="&lt;b&gt;Layer 3 · Services (the rules of the church)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#000066;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=2.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260.0" y="438.0" width="1360.0" height="118.0" as="geometry"/></mxCell><mxCell id="L4" value="&lt;b&gt;Layer 4 · Data access (one repository per module)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#A16207;fillColor=#FAF1D9;strokeColor=#A16207;strokeWidth=2.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260.0" y="626.0" width="1360.0" height="84.0" as="geometry"/></mxCell><mxCell id="L5" value="&lt;b&gt;Layer 5 · The outside world (adapters)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#475569;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260.0" y="780.0" width="1360.0" height="84.0" as="geometry"/></mxCell><mxCell id="lab_v" value="Vendors (Resend, QStash, R2 ...) are reached only&lt;br&gt;through a wrapper service, never straight from a page." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#475569;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="1674.0" y="635.5" width="270.0" height="28.0" as="geometry"/></mxCell><mxCell id="lab_n" value="NEVER: a component importing the&lt;br&gt;database. Screens never touch data&lt;br&gt;access directly." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#D91E2A;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="396.0" width="190.0" height="42.0" as="geometry"/></mxCell><mxCell id="forbid" value="&lt;b style=&quot;font-size:11px&quot;&gt;Four things that are never allowed&lt;/b&gt;&lt;br&gt;1. A screen or component imports a repository or the database.&lt;br&gt;2. A lower layer calls a higher one (a repository calling a service).&lt;br&gt;3. One module reads another module's tables directly. It calls that&lt;br&gt;module's service instead.&lt;br&gt;4. A vendor SDK (Resend, QStash, R2...) is used outside its&lt;br&gt;wrapper service." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#D91E2A;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1750.0" y="130.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B03  ·  Layers: who may call whom&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="1890.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class architecture (UML)   |   Calls travel one way: screen, entry point, service, data access, outside world   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="1890.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1970.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="L1_c0" value="Server Components (pages, SEO)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="L1"><mxGeometry x="16.0" y="40.0" width="190.0" height="26.0" as="geometry"/></mxCell><mxCell id="L1_c1" value="Client Components (forms, players, map)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.4;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="L1"><mxGeometry x="214.0" y="40.0" width="227.4" height="26.0" as="geometry"/></mxCell