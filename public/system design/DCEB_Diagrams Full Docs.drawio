 leader's CV, with a start date."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_branch"><mxGeometry x="10.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_branch_Project" label="Project" link="data:page/id,pg_B40" tooltip="A big thing the church is building, with a thermometer."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_branch"><mxGeometry x="198.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_branch_ProjectMilestone" label="ProjectMilestone" link="data:page/id,pg_B40" tooltip="A step on the staircase."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_branch"><mxGeometry x="10.0" y="120.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_branch_ProjectUpdate" label="ProjectUpdate" link="data:page/id,pg_B41" tooltip="A progress note with a date."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_branch"><mxGeometry x="198.0" y="120.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_branch_ProjectMedia" label="ProjectMedia" link="data:page/id,pg_B41" tooltip="Photos for the project page."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#4338CA;stro