00.0" height="28.0" as="geometry"/></mxCell></object><object id="k_shared_BaseEntity" label="BaseEntity" link="data:page/id,pg_B02" tooltip='The "birth certificate" every record carries: who it is (id), when it was born (createdAt) and when it last changed (updatedAt).'><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="10.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_Publishable" label="Publishable" link="data:page/id,pg_B02" tooltip='Anything with a "Publish" button. One shared set of columns + one shared life-cycle so every content type behaves the same.'><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="198.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_PersonRequest" label="PersonRequest" link="data:page/id,pg_B02" tooltip='A person knocking on the church door and saying "please add me". Same form of knock whatever door they use.'><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="386.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_User" label="User" link="data:page/id,pg_B20" tooltip="The login account of a staff member."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="574.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_Branch" label="Branch" link="data:page/id,pg_B22" tooltip="One church building and its community."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="762.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_Department" label="Department" link="data:page/id,pg_B23" tooltip="A team in the church. A team can have smaller teams inside it."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="950.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_Leader" label="Leader" link="data:page/id,pg_B24" tooltip="A leader's public profile card."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="1138.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_Topic" label="Topic" link="data:page/id,pg_B27" tooltip="A label that can be stuck on many things."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="1326.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_MediaAsset" label="MediaAsset" link="data:page/id,pg_B32" tooltip="The library card for one file."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="10.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_FormDefinition" label="FormDefinition" link="data:page/id,pg_B43" tooltip="A blank form that staff can design."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="198.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_FormField" label="FormField" link="data:page/id,pg_B43" tooltip="One question on the form."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="386.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_AuthzService" label="AuthzService" link="data:page/id,pg_B49" tooltip='The security guard at the door of every action: "are you allowed to do this?"'><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="574.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_TranslationService" label="TranslationService" link="data:page/id,pg_B49" tooltip="The language helper: finds the Kiswahili or English words and says so when one is missing."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="762.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_StorageService" label="StorageService" link="data:page/id,pg_B49" tooltip="The delivery person for photos, PDFs and audio: takes them to the cloud store and brings back a safe link."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="950.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_RateLimiter" label="RateLimiter" link="data:page/id,pg_B49" tooltip="The queue marshal: lets people in at a sensible speed so robots cannot flood the forms."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="1138.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_JobQueue" label="JobQueue" link="data:page/id,pg_B50" tooltip="The to-do list for slow jobs; a worker does them in the background and tries again if they fail."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="1326.0" y="88.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_Mailer" label="Mailer" link="data:page/id,pg_B50" tooltip="The post office: sends the e-mails and writes down what was sent."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="10.0" y="120.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_CacheService" label="CacheService" link="data:page/id,pg_B50" tooltip="The memory shelf: keeps recent answers close so pages load fast."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="198.0" y="120.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_shared_Analytics" label="Analytics" link="data:page/id,pg_B50" tooltip="The people counter: only counts visitors who said yes to counting."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_shared"><mxGeometry x="386.0" y="120.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_editor_Minister" label="Minister" link="data:page/id,pg_B27" tooltip="A preacher who can have many sermons."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=1;rounded=1;arcSize=50;" vertex="1" parent="z_editor"><mxGeometry x="10.0" y="56.0" width="178.0" height="24.0" as="geometry"/></mxCell></object><object id="k_editor_Series" label="Series" link="data:page/id,pg_B27" tooltip="A playlist of sermons."><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B