member: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1049.0" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Project_super" value="Super: CRUDP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="225.9" y="1049.0" width="90.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Project_branch" value="Branch: CRUDP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="323.9" y="1049.0" width="96.1" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Project_editor" value="Editor: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="428.0" y="1049.0" width="69.4" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Project_translator" value="Translator: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FDEEE3;strokeColor=#C2410C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="505.4" y="1049.0" width="88.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Project_treasurer" value="Treasurer: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="602.4" y="1049.0" width="78.9" height="22.0" as="geometry"/></mxCell><mxCell id="acc_ProjectMilestone" value="&lt;b&gt;Who may do what on ProjectMilestone   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1111.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMilestone_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1139.0" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMilestone_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1139.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMilestone_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="213.6" y="1139.0" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMilestone_editor" value="Editor: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="311.1" y="1139.0" width="69.4" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMilestone_treasurer" value="Treasurer: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="388.5" y="1139.0" width="78.9" height="22.0" as="geometry"/></mxCell><mxCell id="n1_Project" value='&lt;b style="font-size:11px"&gt;Project – in plain words&lt;/b&gt;&lt;br&gt;A big thing the church is building, with a thermometer.&lt;br&gt;A church building or mission project with a goal, milestones, impact&lt;br&gt;story and a progress bar.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1201.0" width="337.3" height="136.0" as="geometry"/></mxCell><mxCell id="n2_Project" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Money is stored in the smallest unit (cents) as bigint: KES 1,500.00 =&lt;br&gt;150000. Never floats.&lt;br&gt;• raisedAmountMinor is a CACHE = SUM(ledger where status =&lt;br&gt;recorded); recompute() runs inside the same transaction as every&lt;br&gt;ledger write.&lt;br&gt;• Percent is capped at 100 for display; "remaining" never goes below 0.&lt;br&gt;• "Last updated" = newest of ProjectUpdate.postedAt and&lt;br&gt;LedgerEntry.recordedAt.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1201.0" width="337.3" height="136.0" as="geometry"/></mxCell><mxCell id="n3_Project" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Using decimals/floats for money. 0.1 + 0.2 is not 0.3 in a computer.&lt;br&gt;• Letting editors change goalAmount silently. It is audited and shown in&lt;br&gt;the update log.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1201.0" width="337.3" height="136.0" as="geometry"/></mxCell><mxCell id="n1_ProjectMilestone" value='&lt;b style="font-size:11px"&gt;ProjectMilestone – in plain words&lt;/b&gt;&lt;br&gt;A step on the staircase.&lt;br&gt;Stages of a project (land bought, foundation, roof...). Completed ones&lt;br&gt;are ticked on the project page.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1359.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_ProjectMilestone" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Ordered steps with a target amount or date; "done" is set by Branch&lt;br&gt;Admin.&lt;br&gt;• Percent complete = done milestones / all, shown beside the money&lt;br&gt;bar.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1359.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_ProjectMilestone" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Calculating "percent complete" from money only. A project can be 80%&lt;br&gt;funded and 10% built.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1359.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;A project has a goal amount and milestones. The progress bar compares raised vs goal; milestones show build progress.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1465.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B40  ·  Tab: Project and milestones&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="projectId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;h