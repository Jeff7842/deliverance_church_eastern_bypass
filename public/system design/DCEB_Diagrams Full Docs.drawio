width="70.9" height="22.0" as="geometry"/></mxCell><mxCell id="acc_FeedbackResponse" value="&lt;b&gt;Who may do what on FeedbackResponse   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1127.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_FeedbackResponse_newmember" value="New member: C" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1155.5" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FeedbackResponse_super" value="Super: RX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="153.6" y="1155.5" width="68.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FeedbackResponse_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="229.9" y="1155.5" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FeedbackResponse_editor" value="Editor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="305.7" y="1155.5" width="62.2" height="22.0" as="geometry"/></mxCell><mxCell id="acc_Certificate" value="&lt;b&gt;Who may do what on Certificate   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1217.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_Certificate_newmember" value="New member: CR" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1245.5" width="102.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Certificate_super" value="Super: RUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="160.8" y="1245.5" width="76.1" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Certificate_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="244.9" y="1245.5" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="n1_FeedbackResponse" value='&lt;b style="font-size:11px"&gt;FeedbackResponse – in plain words&lt;/b&gt;&lt;br&gt;The suggestion box.&lt;br&gt;The end-of-tour questionnaire: what they experienced, what to improve,&lt;br&gt;would they invite a friend and why DCEB.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1307.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_FeedbackResponse" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• One per completed journey; answers in JSONB keyed by FormField&lt;br&gt;id.&lt;br&gt;• Read by Super Admin, Branch Admin and Content Editor for&lt;br&gt;improvement only.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1307.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_FeedbackResponse" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Showing feedback with names to the whole team. Show it grouped,&lt;br&gt;names only to the Branch Admin.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1307.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n1_Certificate" value='&lt;b style="font-size:11px"&gt;Certificate – in plain words&lt;/b&gt;&lt;br&gt;A printable "well done" paper with a serial number.&lt;br&gt;The "Completion certificate" generated when the tour ends (later also&lt;br&gt;programme completion).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1413.5" width="337.3" height="162.0" as="geometry"/></mxCell><mxCell id="n2_Certificate" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• serial like DCEB-2026-000123 (year and a running number);&lt;br&gt;verifyCode lets anyone check authenticity at /certificate/CODE.&lt;br&gt;• PDF is stored PRIVATE in R2 and downloaded with a short-lived&lt;br&gt;signed URL.&lt;br&gt;• Rendered once by a QStash job, then cached.&lt;br&gt;• Generated once from a PDF template, stored in a PRIVATE R2 bucket&lt;br&gt;and served by a short-lived signed URL.&lt;br&gt;• serial number is unique and printed on the PDF so it can be verified.&lt;br&gt;• Name on the certificate is exactly what the member typed (they&lt;br&gt;confirm spelling before the PDF is made).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1413.5" width="337.3" height="162.0" as="geometry"/></mxCell><mxCell id="n3_Certificate" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Storing certificates in a public bucket with a guessable URL.&lt;br&gt;• Rendering the PDF in the browser only: a phone may fail; build it on&lt;br&gt;the server.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1413.5" width="337.3" height="162.0" as="geometry"/></mxCell><mxCell id="n1_CertificateService" value='&lt;b style="font-size:11px"&gt;CertificateService – in plain words&lt;/b&gt;&lt;br&gt;The certificate printer: fills the template with the name and saves the&lt;br&gt;PDF safely.&lt;br&gt;Makes the completion PDF.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1597.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_CertificateService" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Builds the PDF (react-pdf or pdf-lib) from the template, uploads to R2,&lt;br&gt;stores Certificate row, returns a signed URL.&lt;br&gt;• Idempotent: calling twice for the same journey returns the same&lt;br&gt;certificate.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1597.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_CertificateService" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Generating the PDF in a request that can time out. Queue it and poll.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1597.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;At the end of the tour the answers are saved and a certificate PDF is made and downloaded.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1703.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B45  ·  Tab: Feedback and certificate&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="journeyId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;startFill=0;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.333;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_FeedbackResponse" target="c_NewMemberJourney"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="334.0" y="328.5"/><mxPoint x="334.0" y="344.3"/></Array></mxGeometry></mxCell><mxCell id="edge0_s" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge0_d" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBac