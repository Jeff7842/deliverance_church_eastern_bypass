xGeometry x="50.0" y="1305.0" width="68.9" height="22.0" as="geometry"/></mxCell><mxCell id="acc_Account" value="&lt;b&gt;Who may do what on Account   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1367.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_Account_super" value="Super: RD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1395.0" width="68.9" height="22.0" as="geometry"/></mxCell><mxCell id="acc_Verification" value="&lt;b&gt;Who may do what on Verification   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1457.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_Verification_super" value="Super: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1485.0" width="61.7" height="22.0" as="geometry"/></mxCell><mxCell id="n1_User" value='&lt;b style="font-size:11px"&gt;User – in plain words&lt;/b&gt;&lt;br&gt;The login account of a staff member.&lt;br&gt;A staff login. Managed by Better Auth (its "user" table). Only staff have&lt;br&gt;accounts at launch.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1547.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n2_User" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Better Auth owns this table and its id type is text, so every "createdBy /&lt;br&gt;handledBy" column in our own tables is also text.&lt;br&gt;• Email must be verified before a user can receive any role.&lt;br&gt;• Banning a user (admin plugin) kills all their sessions immediately.&lt;br&gt;• Public visitors never get a row here at launch.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1547.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n3_User" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Adding church columns (phone, branch) straight onto the Better Auth&lt;br&gt;table. Put them in StaffProfile so auth upgrades never fight your&lt;br&gt;schema.&lt;br&gt;• Using the plugin "role" field as the whole permission system. It only&lt;br&gt;says user/admin; real scoped roles live in RoleAssignment.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1547.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n1_Session" value='&lt;b style="font-size:11px"&gt;Session – in plain words&lt;/b&gt;&lt;br&gt;A "you are logged in" wristband.&lt;br&gt;One row per signed-in browser. Better Auth creates and expires these.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1667.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n2_Session" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Short expiry for admin (e.g. 7 days sliding) and revoke-all on password&lt;br&gt;change.&lt;br&gt;• Cookie is httpOnly, secure, sameSite=lax.&lt;br&gt;• Created and destroyed by Better Auth only. Application code never&lt;br&gt;inserts here.&lt;br&gt;• Cookie is httpOnly + secure + sameSite=lax; a session lasts 7 days&lt;br&gt;and refreshes on use.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1667.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n3_Session" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Writing your own session code next to Better Auth. Two systems = two&lt;br&gt;bugs.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1667.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n1_Account" value='&lt;b style="font-size:11px"&gt;Account – in plain words&lt;/b&gt;&lt;br&gt;The key that opens the login.&lt;br&gt;Stores HOW a user proves who they are (password hash, or Google&lt;br&gt;later).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1811.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_Account" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• One user may have several accounts (email+password now, Google&lt;br&gt;later). Better Auth owns this table.&lt;br&gt;• Password hash never leaves the server and is never logged.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1811.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_Account" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Storing plain passwords or logging login requests with bodies.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1811.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_Verification" value='&lt;b style="font-size:11px"&gt;Verification – in plain words&lt;/b&gt;&lt;br&gt;One-time codes that expire.&lt;br&gt;Short-lived codes for email verification and password reset.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1905.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_Verification" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Short-lived tokens for e-mail verification and password reset (minutes,&lt;br&gt;single use).&lt;br&gt;• A cron/QStash job deletes expired rows daily.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1905.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_Verification" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Letting tokens live for days. Short life = small damage if an email is&lt;br&gt;forwarded.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1905.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Better Auth owns these four tables. DCEB adds nothing to them except the "role" link in the next tab, so upgrades stay painless.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1999.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B20  ·  Tab: Better Auth core (User, Session, Account, Verification)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="userId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.5;endArrow=none;endFill=0;startArrow=diamondThin;startFill=1;exitX=0.143;exitY=1.000;exitDx=0;exitDy=0;entryX=0.333;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_User" target="c_Session"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="112.9" y="429.0"/><mxPoint x="170.0" y="429.0"/></Array></mxGeometry></mxCell><mxCell id="edge0_s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge0_d" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge1" value="impersonatedBy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;startFill=0;exitX=0.667;exitY=0.000;exitDx=0;exitDy=0;entryX=0.286;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_Session" target="c_User"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270.0" y="429.0"/><mxPoint x="155.7" y="429.0"/></Array></mxGeometry></mxCell><mxCell id="edge1_s" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge1"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge1_d" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge1"><mxGeometry x="0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge2" value="userId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.5;endArrow=none;endFill=0;startArrow=diamondThin;startFill=1;exitX=0.429;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_User" target="c_Account"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="198.6" y="436.0"/><mxPoint x="392.0" y="436.0"/><mxPoint x="392.0" y="660.0"/><mxPoint x="220.0" y="660.0"/></Array></mxGeometry></mxCell><mxCell id="edge2_s" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge2"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge2_d" value="0..*" style="