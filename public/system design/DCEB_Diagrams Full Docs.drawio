.5" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_EventGuest_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="213.6" y="1419.5" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_EventGuest_events" value="Events: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE6F0;strokeColor=#BE185D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="311.1" y="1419.5" width="87.8" height="22.0" as="geometry"/></mxCell><mxCell id="acc_EventSession" value="&lt;b&gt;Who may do what on EventSession   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1481.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_EventSession_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1509.5" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_EventSession_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1509.5" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_EventSession_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="213.6" y="1509.5" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_EventSession_events" value="Events: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE6F0;strokeColor=#BE185D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="311.1" y="1509.5" width="87.8" height="22.0" as="geometry"/></mxCell><mxCell id="n1_Event" value='&lt;b style="font-size:11px"&gt;Event – in plain words&lt;/b&gt;&lt;br&gt;A date on the church calendar.&lt;br&gt;Anything with a date: youth conference, marriage conference, worship&lt;br&gt;conference, youth trip, mission week.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1571.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n2_Event" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• registrationMode: none | form (our form) | external (link) | walk_in.&lt;br&gt;• seatsLeft = capacity - confirmed attendees (computed, not stored).&lt;br&gt;• Guest ministers come from EventGuest, so the same Minister page&lt;br&gt;works for sermons and events.&lt;br&gt;• Fees are INFORMATION only (giving details); no payment at launch.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1571.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n3_Event" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• A separate table for every kind of event. category + optional subtype&lt;br&gt;(OutreachActivity) is enough.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1571.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n1_EventGuest" value='&lt;b style="font-size:11px"&gt;EventGuest – in plain words&lt;/b&gt;&lt;br&gt;Speaker list for an event.&lt;br&gt;Which ministers speak at which event.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1691.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_EventGuest" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• A guest minister attached to an event; may be an internal Minister or&lt;br&gt;an external name + photo.&lt;br&gt;• Shown on the event card as "Guest: Pastor ...".' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1691.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_EventGuest" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Making guest ministers free text on Event: you lose "all events with&lt;br&gt;this minister".' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1691.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_EventSession" value='&lt;b style="font-size:11px"&gt;EventSession – in plain words&lt;/b&gt;&lt;br&gt;One slot in the conference timetable.&lt;br&gt;The day-by-day programme of a multi-day conference.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1785.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_EventSession" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• One event can have many sessions (Day 1 morning, Day 1 evening).&lt;br&gt;• startsAt/endsAt are timestamptz; the page renders them in&lt;br&gt;Africa/Nairobi.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1785.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_EventSession" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Storing local time without timezone; a phone abroad will show the&lt;br&gt;wrong hour.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1785.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;An Event is anything with a date. Guests and sessions hang under it.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1879.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B34  ·  Tab: Event, guests, sessions&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="departmentId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;startFill=0;exitX=0.000;exitY=0.333;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_Event" target="c_Department"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="334.0" y="414.0"/><mxPoint x="334.0" y="494.2"/></Array></mxGeometry></mxCell><mxCell id="