ill=0;startArrow=none;startFill=0;dashed=1;dashPattern=6 4;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_cert" target="u_fb"><mxGeometry x="0.000" relative="1" as="geometry"><mxPoint x="0.0" y="-16.0" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg_U04" name="U04 Content team: editor and translator"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1278" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bnd" value="&lt;b&gt;DCEB admin area: content and translations&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#475569;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;dashed=1;dashPattern=6 4;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260.0" y="150.0" width="796.0" height="1260.0" as="geometry"/></mxCell><mxCell id="editor" value="Content Editor" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40.0" y="818.8" width="92.0" height="72.0" as="geometry"/></mxCell><mxCell id="translator" value="Translator /&lt;br&gt;Reviewer" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FDEEE3;strokeColor=#C2410C;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40.0" y="1106.0" width="92.0" height="86.0" as="geometry"/></mxCell><mxCell id="engine" value="Translation&lt;br&gt;engine (machine)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1146.0" y="909.0" width="92.0" height="86.0" as="geometry"/></mxCell><mxCell id="howto" value='&lt;b style="font-size:11px"&gt;How to read this page&lt;/b&gt;&lt;br&gt;• A stick figure is a PERSON or an outside SERVICE that uses the system.&lt;br&gt;• An oval is one thing they can do (a use case).&lt;br&gt;• A grey frame groups ovals. A line from an actor to a frame means the actor takes part in EVERY oval inside it. A line to one oval means&lt;br&gt;only that oval.&lt;br&gt;• A dashed purple arrow means "this oval always uses that one" (include) or "may add this step" (extend).&lt;br&gt;• The dashed outline is the edge of our website; anything outside it is not ours.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1440.0" width="640.0" height="112.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;U04  ·  Content team: editor and translator&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="72.0" width="1048.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="UML: use cases   |   Publishing, moderating and translating, and what each of the two roles may touch   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="102.0" width="1048.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&