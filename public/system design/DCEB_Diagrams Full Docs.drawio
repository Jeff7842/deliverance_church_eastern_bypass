vetica;fontSize=11;fontStyle=1;fontColor=#0F766E;fillColor=#E6F4F1;strokeColor=#0F766E;strokeWidth=1.6;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="120.0" width="235.0" height="1208.0" as="geometry"/></mxCell><mxCell id="s" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="156.5" y="205.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="cr" value="Creates the event: date, place,&lt;br&gt;guest ministers, sessions,&lt;br&gt;capacity" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="291.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="fm" value="Picks or builds the registration&lt;br&gt;form (fields, consent text)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="402.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="pb" value="Publishes the event page and&lt;br&gt;the registration link" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="402.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="sw" value="Sees the event and opens the&lt;br&gt;form" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="553.0" y="506.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="rg" value="Sends the registration (name,&lt;br&gt;phone, group size)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="553.0" y="610.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="ck" value="Open and seats left?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="313.5" y="615.0" width="178.0" height="34.0" as="geometry"/></mxCell><mxCell id="wl" value='Sees "Event is full. Join the&lt;br&gt;waiting list?"' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="553.0" y="714.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="sv" value="Save the registration (confirmed,&lt;br&gt;pending or waiting); e-mail or&lt;br&gt;SMS with a calendar file" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="811.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="cf" value='Sees the confirmation and "Add&lt;br&gt;to calendar"' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="553.0" y="922.0" width="169.0" height="44.0" a