pace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="926.0" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_HomeFellowship_newmember" value="New member: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="926.0" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_HomeFellowship_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="225.9" y="926.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_HomeFellowship_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="317.2" y="926.0" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_HomeFellowship_dept" value="Dept leader: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E5F4EA;strokeColor=#15803D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="414.7" y="926.0" width="109.5" height="22.0" as="geometry"/></mxCell><mxCell id="n1_HomeFellowship" value="&lt;b style=&quot;font-size:11px&quot;&gt;HomeFellowship – in plain words&lt;/b&gt;&lt;br&gt;A small church that meets in somebody's sitting room.&lt;br&gt;One small group that meets in a home. Its coordinates power the &quot;find&lt;br&gt;my nearest fellowship&quot; feature." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="988.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n2_HomeFellowship" value="&lt;b style=&quot;font-size:11px&quot;&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• lat/lng required: no coordinates, no &quot;nearest&quot; result.&lt;br&gt;• Public contact is the fellowship contact, never the host's private&lt;br&gt;number unless they agreed.&lt;br&gt;• status = full or paused removes it from &quot;nearest&quot; results but keeps the&lt;br&gt;page." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="988.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n3_HomeFellowship" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Searching by typing the estate name only. Typos break it; coordinates&lt;br&gt;+ a typed fallback is robust.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="988.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n1_FellowshipLocator" value='&lt;b style="font-size:11px"&gt;FellowshipLocator – in plain words&lt;/b&gt;&lt;br&gt;The "which fellowship is nearest me?" calculator.&lt;br&gt;Distance maths for the closest home fellowship.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1108.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_FellowshipLocator" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Primary: browser geolocation (asks permission). Fallback: typed&lt;br&gt;estate/area matched against HomeFellowship.areaText.&lt;br&gt;• Distance = Haversine on lat/lng; returns the 3 nearest with their&lt;br&gt;meeting day and leader contact.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1108.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_FellowshipLocator" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Silently using the IP address for location. Ask permission or let them&lt;br&gt;type.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1108.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;The nearest-fellowship feature = HomeFellowship rows with latitude/longitude + FellowshipLocator code that measures distance.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1214.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B25  ·  Tab: Home fellowship&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="departmentId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;startFill=0;exitX=0.000;exitY=0.333;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_HomeFellowship" target="c_Department"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge0_s" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge0_d" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#6474