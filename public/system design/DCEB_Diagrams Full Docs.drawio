er;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="291.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="tv" value="Check Turnstile, rate limit and&lt;br&gt;the form rules" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="298.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="dp" value="Phone already recorded?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="338.5" y="395.0" width="128.0" height="58.0" as="geometry"/></mxCell><mxCell id="nt" value='Sees "Already recorded: a note&lt;br&gt;was added" (nothing is counted&lt;br&gt;twice)' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="395.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="e2" value="" style="ellipse;html=1;shape=endState;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="154.5" y="515.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="cr" value="Create the Convert (counted)&lt;br&gt;and a follow-up case, due in 48&lt;br&gt;hours" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="499.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="th" value='Sees "Thank you. A friend from&lt;br&gt;DCEB will contact you."' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="610.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="as" value="Job: pick the discipler with the&lt;br&gt;fewest open cases in that&lt;br&gt;branch" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="603.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="sm" value='Gets an SMS or e-mail: "New&lt;br&gt;believer: call within 48 hours"' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="788.0" y="610.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="cl" value="Calls or visits; logs every&lt;br&gt;attempt (what, when, result)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="788.0" y="714.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="rc" value="Person reached?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="798.5" y="823.0" width="148.0" height="34.0" as="geometry"/></mxCell><mxCell id="un" value="After 3 failed tries: mark&lt;br&gt;unreachable; ask for a new&lt;br&gt;number" style="whiteSpace=wrap;html=1;fontFam