748B;fillColor=#F4F4F5;strokeColor=#334155;strokeWidth=1.5;dashed=1;dashPattern=6 4;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="976.0" width="1060.0" height="62.0" as="geometry"/></mxCell><mxCell id="sv_0" value="RateLimiter" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1004.0" width="77.0" height="22.0" as="geometry"/></mxCell><mxCell id="sv_1" value="ModerationService" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="135.0" y="1004.0" width="111.5" height="22.0" as="geometry"/></mxCell><mxCell id="acc_BlogPost" value="&lt;b&gt;Who may do what on BlogPost   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1062.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1090.0" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_newmember" value="New member: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1090.0" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_super" value="Super: CRUDPA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="225.9" y="1090.0" width="96.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_branch" value="Branch: CRUDPA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="330.3" y="1090.0" width="102.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_editor" value="Editor: CRUDP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="441.0" y="1090.0" width="90.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_translator" value="Translator: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FDEEE3;strokeColor=#C2410C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="539.5" y="1090.0" width="88.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_dept" value="Dept leader: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="636.4" y="1090.0" width="87.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_discipler" value="Discipler: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="732.2" y="1090.0" width="75.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_treasurer" value="Treasurer: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="815.8" y="1090.0" width="78.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_BlogPost_events" value="Events: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="902.7" y="1090.0" width="66.1" height="22.0" as="geometry"/></mxCell><mxCell id="acc_Comment" value="&lt;b&gt;Who may do what on Comment   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1152.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_Comment_visitor" value="Visitor: S" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1180.0" width="63.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Comment_newmember" value="New member: S" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="121.7" y="1180.0" width="95.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Comment_super" value="Super: RUDA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="224.8" y="1180.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Comment_branch" value="Branch: RUDA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="316.1" y="1180.0" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Comment_editor" value="Editor: RUDA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="413.6" y="1180.0" width="83.9" height="22.0" as="geometry"/></mxCell><mxCell id="n1_BlogPost" value='&lt;b style="font-size:11px"&gt;BlogPost – in plain words&lt;/b&gt;&lt;br&gt;A written article.&lt;br&gt;Written articles. Blogs are written in ONE language first; a Translation&lt;br&gt;row adds the other.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1242.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n2_BlogPost" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• body is rich text (Tiptap JSON or MDX) stored in the translation row.&lt;br&gt;• Reading time is computed on save, not on every view.&lt;br&gt;• Translation is per field (title, excerpt, body) in blog_post_translation;&lt;br&gt;the English row is the source of truth for slug.&lt;br&gt;• body is stored as Tiptap JSON, rendered to HTML on the server and&lt;br&gt;sanitised.&lt;br&gt;• allowComments can be switched off per post.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1242.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n3_BlogPost" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Pasting raw HTML from Word. It brings hidden styles and scripts; use&lt;br&gt;the editor and sanitise.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1242.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n1_Comment" value="&lt;b style=&quot;font-size:11px&quot;&gt;Comment – in plain words&lt;/b&gt;&lt;br&gt;A message left under a sermon.&lt;br&gt;A visitor's comment under a sermon or blog. Starts as &quot;pending&quot; until a&lt;br&gt;moderator approves." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1386.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n2_Comment" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Exactly one of sermonId / blogPostId is set (CHECK).&lt;br&gt;• Honeypot field + Turnstile + Upstash rate limit before the row is&lt;br&gt;created.&lt;br&gt;• Emails are never shown publicly.&lt;br&gt;• Replies one level deep (parentId) to keep the page readable.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1386.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n3_Comment" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Publishing comments instantly. The first spam wave will land on a&lt;br&gt;church page.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1386.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Comments hang under either a sermon or a blog post, never both.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1506.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B28  ·  Tab: Blog and comments&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="authorMinisterId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;startFill=0;exitX=0.000;exitY=0.333;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_BlogPost" target="c_Minister"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="334.0" y="376.0"/><mxPoint x="334.0" y="374.5"/></Array></mxGeometry></mxCell><mxCell id="edge0_s" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge0_d" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge1" value="categoryId"