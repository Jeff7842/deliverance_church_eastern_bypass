="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.0" y="642.0" as="sourcePoint"/><mxPoint x="940.0" y="642.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg9" value="10. POST /api/jobs/assign-case" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940.0" y="676.0" as="sourcePoint"/><mxPoint x="350.0" y="676.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg10" value="11. pick the discipler with the fewest open cases in that branch" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.0" y="710.0" as="sourcePoint"/><mxPoint x="740.0" y="710.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg11" value='12. SMS/email to the discipler: "New believer: call within 48h"' style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.0" y="744.0" as="sourcePoint"/><mxPoint x="1340.0" y="744.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg12" value="13. open /admin/followup (only my cases)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140.0" y="808.0" as="sourcePoint"/><mxPoint x="750.0" y="808.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg13" value="14. INSERT contact_attempt(call, reached, note)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140.0" y="842.0" as="sourcePoint"/><mxPoint x="750.0" y="842.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg14" value="15. UPDATE follow_up_case.status = connected; optional enrol in New Born Again cohort" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140.0" y="888.0" as="sourcePoint"/><mxPoint x="750.0" y="888.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg15" value="16. reminder job" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940.0" y="948.0" as="sourcePoint"/><mxPoint x="350.0" y="948.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg16" value="17. remind discipler, then escalate to the Branch Admin on day 5" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.0" y="982.0" as="sourcePoint"/><mxPoint x="1340.0" y="982.0" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg_S07" name="S07 Event registration (youth trip, conference)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fol