geService_m1" value="signedUrl(key, ttl): Url" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_StorageService"><mxGeometry x="0.0" y="76.5" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_StorageService_m2" value="remove(key): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_StorageService"><mxGeometry x="0.0" y="93.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_RateLimiter" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;RateLimiter' style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#334155;strokeColor=#334155;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="625.0" width="300.0" height="80.5" as="geometry"/></mxCell><mxCell id="c_RateLimiter_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#334155;" vertex="1" parent="c_RateLimiter"><mxGeometry x="0.0" y="52.0" width="300.0" height="8.0" as="geometry"/></mxCell><mxCell id="c_RateLimiter_m0" value="limit(key, rule): Result" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_RateLimiter"><mxGeometry x="0.0" y="60.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="call_box" value="&lt;b&gt;Called by (classes that depend on this service)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#F4F4F5;strokeColor=#334155;strokeWidth=1.5;dashed=1;dashPattern=6 4;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="755.5" width="1060.0" height="92.0" as="geometry"/></mxCell><mxCell id="cb_0" value="User" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="783.5" width="44.2" height="22.0" as="geometry"/></mxCell><mxCell id="cb_1" value="RoleAssignment" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="102.2" y="783.5" width="100.9" height="22.0" as="geometry"/></mxCell><mxCell id="cb_2" value="LedgerEntry" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="211.1" y="783.5" width="80.9" height="22.0" as="geometry"/></mxCell><mxCell id="cb_3" value="Department" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="300.1" y="783.5" width="77.6" height="22.0" as="geometry"/></mxCell><mxCell id="cb_4" value="Sermon" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="385.6" y="783.5" width="59.2" height="22.0" as="geometry"/></mxCell><mxCell id="cb_5" value="Event" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="452.9" y="783.5" width="49.2" height="22.0" as="geometry"/></mxCell><mxCell id="cb_6" value="Project" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="510.1" y="783.5" width="55.9" height="22.0" as="geometry"/></mxCell><mxCell id="cb_7" value="MediaAsset" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="574.0" y="783.5" width="77.6" height="22.0" as="geometry"/></mxCell><mxCell id="cb_8" value="Certificate" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="659.6" y="783.5" width="70.9" height="22.0" as="geometry"/></mxCell><mxCell id="cb_9" value="Comment" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="738.5" y="783.5" width="68.1" height="22.0" as="geometry"/></mxCell><mxCell id="cb_10" value="EventRegistration" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="814.6" y="783.5" width="107.6" height="22.0" as="geometry"/></mxCell><mxCell id="cb_11" value="Convert" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="930.2" y="783.5" width="59.8" height="22.0" as="geometry"/></mxCell><mxCell id="cb_12" value="NewsletterSubscriber" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="813.5" width="124.8" height="22.0" as="geometry"/></mxCell><mxCell id="n1_AuthzService" value='&lt;b style="font-size:11px"&gt;AuthzService – in plain words&lt;/b&gt;&lt;br&gt;The security guard at the door of every action: "are you allowed to do&lt;br&gt;this?"&lt;br&gt;One function every server action calls before touching data.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="871.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_AuthzService" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Every Server Action and Route Handler starts with assertCan(...). No&lt;br&gt;exception.&lt;br&gt;• Decisions use RoleAssignment (role + scope) loaded once per request&lt;br&gt;and cached for that request only.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="871.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_AuthzService" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Checking permissions only in the UI (hiding buttons). The server must&lt;br&gt;check too.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="871.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n1_TranslationService" value='&lt;b style="font-size:11px"&gt;TranslationService – in plain words&lt;/b&gt;&lt;br&gt;The language helper: finds the Kiswahili or English words and says so&lt;br&gt;when one is missing.&lt;br&gt;Reads the right language, falls back safely, and drives the AI-draft to&lt;br&gt;human-review flow.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="977.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n2_TranslationService" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Fallback chain: requested locale -&amp;gt; other locale -&amp;gt; marked "not yet&lt;br&gt;translated" badge.&lt;br&gt;• Machine drafts are stored as status machine_draft and never shown&lt;br&gt;publicly until approved (or flagged "auto-translated" if Super Admin&lt;br&gt;allows).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="977.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n3_TranslationService" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Translating on every page view. Translate once, store, approve.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="977.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n1_StorageService" value='&lt;b style="font-size:11px"&gt;StorageService – in plain words&lt;/b&gt;&lt;br&gt;The delivery person for photos, PDFs and audio: takes them to the&lt;br&gt;cloud store and brings back a safe link.&lt;br&gt;Only class allowed to talk to Cloudflare R2.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1097.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_StorageService" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Uploads go browser -&amp;gt; R2 by presigned URL (the file never passes&lt;br&gt;through Vercel).&lt;br&gt;• Files are checked for type, size and (images) re-encoded to strip&lt;br&gt;hidden data.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1097.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_StorageService" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Trusting the file extension. Check the real type.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1097.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n1_RateLimiter" value='&lt;b style="font-size:11px"&gt;RateLimiter – in plain words&lt;/b&gt;&lt;br&gt;The queue marshal: lets people in at a sensible speed so robots cannot&lt;br&gt;flood the forms.&lt;br&gt;Upstash Ratelimit wrapper: per IP, per device, per form.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1203.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_RateLimiter" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Sliding-window limits per IP-hash and per route in Upstash Redis.&lt;br&gt;• Limits: comment 5/10min, newsletter 3/hour, contact 3/hour, converts&lt;br&gt;20/hour per staff device.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1203.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_RateLimiter" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• One global limit for the whole site. A single noisy visitor blocks&lt;br&gt;everyone.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1203.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Four services that nearly every module calls. They are code, not tables.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1297.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B49  ·  Tab: Platform services (security, language, files)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="pg_B50" name="B50 Tab: Platform services (jobs, mail, cache, analytics)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="1261" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_JobQueue" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;JobQueue' style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#334155;strokeColor=#334155;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="130.0" width="300.0" height="113.5" as="geometry"/></mxCell><mxCell id="c_JobQueue_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#334155;" vertex="1" parent="c_JobQueue"><mxGeometry x="0.0" y="52.0" width="300.0" height="8.0" as="geometry"/></mxCell><mxCell id="c_JobQueue_m0" value="enqueue(job, delay): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_JobQueue"><mxGeometry x="0.0" y="60.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_JobQueue_m1" value="schedule(cron, job): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_JobQueue"><mxGeometry x="0.0" y="76.5" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_JobQueue_m2" value="verify(signature): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_JobQueue"><mxGeometry x="0.0" y="93.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_Mailer" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;Mailer' style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#334155;strokeColor=#334155;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="289.5" width="300.0" height="97.0" as="geometry"/></mxCell><mxCell id="c_Mailer_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#334155;" vertex="1" parent="c_Mailer"><mxGeometry x="0.0" y="52.0" width="300.0" height="8.0" as="geometry"/></mxCell><mxCell id="c_Mailer_m0" value="send(template, to, data): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Mailer"><mxGeometry x="0.0" y="60.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_Mailer_m1" value="syncContact(sub): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Mailer"><mxGeometry x="0.0" y="76.5" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_CacheService" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;CacheService' style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#334155;strokeColor=#334155;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="432.5" width="300.0" height="113.5" as="geometry"/></mxCell><mxCell id="c_CacheService_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#334155;" vertex="1" parent="c_CacheService"><mxGeometry x="0.0" y="52.0" width="300.0" height="8.0" as="geometry"/></mxCell><mxCell id="c_CacheService_m0" value="tag(name): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_CacheService"><mxGeometry x="0.0" y="60.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_CacheService_m1" value="revalidate(tags): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_CacheService"><mxGeometry x="0.0" y="76.5" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_CacheService_m2" value="counter(key): Counter" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_CacheService"><mxGeometry x="0.0" y="93.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_Analytics" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;Analytics' style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#334155;strokeColor=#334155;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="592.0" width="300.0" height="97.0" as="geometry"/></mxCell><mxCell id="c_Analytics_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#334155;" vertex="1" parent="c_Analytics"><mxGeometry x="0.0" y="52.0" width="300.0" height="8.0" as="geometry"/></mxCell><mxCell id="c_Analytics_m0" value="capture(event, props): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Analytics"><mxGeometry x="0.0" y="60.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_Analytics_m1" value="flag(key): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_Analytics"><mxGeometry x="0.0" y="76.5" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="call_box" value="&lt;b&gt;Called by (classes that depend on this service)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#F4F4F5;strokeColor=#334155;strokeWidth=1.5;dashed=1;dashPattern=6 4;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="739.0" width="1060.0" height="62.0" as="geometry"/></mxCell><mxCell id="cb_0" value="Event" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="767.0" width="49.2" height="22.0" as="geometry"/></mxCell><mxCell id="cb_1" value="Convert" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="107.2" y="767.0" width="59.8" height="22.0" as="geometry"/></mxCell><mxCell id="cb_2" value="FollowUpCase" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="175.0" y="767.0" width="90.9" height="22.0" as="geometry"/></mxCell><mxCell id="cb_3" value="JoinRequest" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="273.9" y="767.0" width="82.0" height="22.0" as="geometry"/></mxCell><mxCell id="cb_4" value="EventRegistration" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="363.9" y="767.0" width="107.6" height="22.0" as="geometry"/></mxCell><mxCell id="cb_5" value="NewsletterSubscriber" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="479.5" y="767.0" width="124.8" height="22.0" as="geometry"/></mxCell><mxCell id="cb_6" value="Sermon" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="612.4" y="767.0" width="59.2" height="22.0" as="geometry"/></mxCell><mxCell id="cb_7" value="Project" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="679.6" y="767.0" width="55.9" height="22.0" as="geometry"/></mxCell><mxCell id="cb_8" value="LedgerEntry" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="743.5" y="767.0" width="80.9" height="22.0" as="geometry"/></mxCell><mxCell id="n1_JobQueue" value='&lt;b style="font-size:11px"&gt;JobQueue – in plain words&lt;/b&gt;&lt;br&gt;The to-do list for slow jobs; a worker does them in the background and&lt;br&gt;tries again if they fail.&lt;br&gt;QStash wrapper for emails, reminders, digests, counter flush.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="825.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_JobQueue" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• All slow or retryable work (emails, counters flush, translation drafts)&lt;br&gt;goes through QStash with signed requests.&lt;br&gt;• Jobs are idempotent: running twice must not double-send.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="825.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_JobQueue" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Running jobs that are not idempotent. A retry then sends the same&lt;br&gt;email twice.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="825.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_Mailer" value='&lt;b style="font-size:11px"&gt;Mailer – in plain words&lt;/b&gt;&lt;br&gt;The post office: sends the e-mails and writes down what was sent.&lt;br&gt;Resend wrapper; every send is logged in NotificationLog.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="919.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_Mailer" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Templates are React Email components, one per message, bilingual.&lt;br&gt;• Sending domain has SPF, DKIM and DMARC set in DNS before the&lt;br&gt;first campaign.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="919.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_Mailer" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Sending from a no-reply address with no SPF/DKIM: it lands in spam.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="919.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_CacheService" value='&lt;b style="font-size:11px"&gt;CacheService – in plain words&lt;/b&gt;&lt;br&gt;The memory shelf: keeps recent answers close so pages load fast.&lt;br&gt;Next.js cache tags + Upstash Redis counters.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1013.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_CacheService" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Next.js cache tags for pages, Redis for counters and shared lookups.&lt;br&gt;• After a publish, call revalidateTag(tag) so the public sees the change&lt;br&gt;within seconds.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1013.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_CacheService" value="&lt;b style=&quot;font-size:11px&quot;&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Caching pages that show a logged-in user's data. Only cache public&lt;br&gt;pages." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1013.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_Analytics" value='&lt;b style="font-size:11px"&gt;Analytics – in plain words&lt;/b&gt;&lt;br&gt;The people counter: only counts visitors who said yes to counting.&lt;br&gt;PostHog wrapper that respects cookie consent.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1107.0" width="337.3" height="58.0" as="geometry"/></mxCell><mxCell id="n2_Analytics" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• PostHog loads ONLY after the visitor accepts analytics cookies.&lt;br&gt;• Event names follow the taxonomy page (object_action, snake_case).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1107.0" width="337.3" height="58.0" as="geometry"/></mxCell><mxCell id="n3_Analytics" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Loading PostHog before consent. Under Kenyan and EU rules that is&lt;br&gt;a breach.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1107.0" width="337.3" height="58.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Four more services. Each wraps one outside tool (QStash, Resend, Upstash/Next cache, PostHog) so the tool can be swapped without touching the modules.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1187.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B50  ·  Tab: Platform services (jobs, mail, cache, analytics)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="pg_B51" name="B51 Tab: Feature services (moderation, overlays)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_ModerationService" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;ModerationService' style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#334155;strokeColor=#334155;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="130.0" width="300.0" height="97.0" as="geometry"/></mxCell><mxCell id="c_ModerationService_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#334155;" vertex="1" parent="c_ModerationService"><mxGeometry x="0.0" y="52.0" width="300.0" height="8.0" as="geometry"/></mxCell><mxCell id="c_ModerationService_m0" value="score(text): Risk" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ModerationService"><mxGeometry x="0.0" y="60.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_ModerationService_m1" value="isHoneypotTripped(form): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ModerationService"><mxGeometry x="0.0" y="76.5" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_OverlayOrchestrator" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;OverlayOrchestrator' style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#334155;strokeColor=#334155;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70.0" y="273.0" width="300.0" height="113.5" as="geometry"/></mxCell><mxCell id="c_OverlayOrchestrator_sep" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#334155;" vertex="1" parent="c_OverlayOrchestrator"><mxGeometry x="0.0" y="52.0" width="300.0" height="8.0" as="geometry"/></mxCell><mxCell id="c_OverlayOrchestrator_m0" value="next(): Overlay" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_OverlayOrchestrator"><mxGeometry x="0.0" y="60.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_OverlayOrchestrator_m1" value="canShow(o): bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_OverlayOrchestrator"><mxGeometry x="0.0" y="76.5" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_OverlayOrchestrator_m2" value="dismiss(o, days): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_OverlayOrchestrator"><mxGeometry x="0.0" y="93.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="call_box" value="&lt;b&gt;Called by (classes that depend on this service)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#F4F4F5;strokeColor=#334155;strokeWidth=1.5;dashed=1;dashPattern=6 4;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="436.5" width="1060.0" height="62.0" as="geometry"/></mxCell><mxCell id="cb_0" value="Comment" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="464.5" width="68.1" height="22.0" as="geometry"/></mxCell><mxCell id="cb_1" value="NewMemberJourney" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="126.1" y="464.5" width="119.8" height="22.0" as="geometry"/></mxCell><mxCell id="n1_ModerationService" value='&lt;b style="font-size:11px"&gt;ModerationService – in plain words&lt;/b&gt;&lt;br&gt;The doorkeeper for comments and messages: checks for spam before&lt;br&gt;they reach a human.&lt;br&gt;First-line spam checks for comments and contact messages.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="522.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_ModerationService" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Checks: honeypot, link count, banned words list (EN + SW), duplicate&lt;br&gt;body, rate limit result.&lt;br&gt;• A suspicious item becomes status "pending", never silently dropped.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="522.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_ModerationService" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Relying only on word lists. Add rate limits and the human review&lt;br&gt;queue.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="522.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_OverlayOrchestrator" value='&lt;b style="font-size:11px"&gt;OverlayOrchestrator – in plain words&lt;/b&gt;&lt;br&gt;The traffic light for pop-ups so only one shows at a time.&lt;br&gt;Client-side traffic cop: cookie bar, new-member modal, newsletter&lt;br&gt;modal never fight.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="616.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_OverlayOrchestrator" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Order of overlays: 1 cookie bar (bottom), 2 new-member modal, 3&lt;br&gt;newsletter modal (after About section).&lt;br&gt;• Only ONE modal at a time; dismissals are remembered (localStorage,&lt;br&gt;and cookie if accepted).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="616.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_OverlayOrchestrator" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Letting three popups open together on a phone. The visitor leaves.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="616.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Two small services owned by features: comment/contact moderation and the pop-up traffic light.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="722.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B51  ·  Tab: Feature services (moderation, overlays)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="pg_U01" name="U01 Visitor: read, listen and explore"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1264" pageHeight="1642" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bnd" value="&lt;b&gt;DCEB website: public pages (English and Kiswahili)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#475569;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;dashed=1;dashPattern=6 4;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260.0" y="150.0" width="796.0" height="1342.0" as="geometry"/></mxCell><mxCell id="visitor" value="Visitor&lt;br&gt;(no login)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6F4F1;strokeColor=#0F766E;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40.0" y="840.4" width="78.0" height="86.0" as="geometry"/></mxCell><mxCell id="maps" value="Map service&lt;br&gt;(location map)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1146.0" y="469.0" width="78.0" height="86.0" as="geometry"/></mxCell><mxCell id="yt" value="YouTube&lt;br&gt;(video host)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1146.0" y="689.0" width="78.0" height="86.0" as="geometry"/></mxCell><mxCell id="search" value="Search engine&lt;br&gt;(Google)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=1.5;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="1146.0" y="1405.0" width="78.0" height="86.0" as="geometry"/></mxCell><mxCell id="howto" value='&lt;b style="font-size:11px"&gt;How to read this page&lt;/b&gt;&lt;br&gt;• A stick figure is a PERSON or an outside SERVICE that uses the system.&lt;br&gt;• An oval is one thing they can do (a use case).&lt;br&gt;• A grey frame groups ovals. A line from an actor to a frame means the actor takes part in EVERY oval inside it. A line to one oval means&lt;br&gt;only that oval.&lt;br&gt;• A dashed purple arrow means "this oval always uses that one" (include) or "may add this step" (extend).&lt;br&gt;• The dashed outline is the edge of our website; anything outside it is not ours.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1522.0" w