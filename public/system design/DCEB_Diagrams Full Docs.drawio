="1" pageScale="1" pageWidth="1240" pageHeight="1298" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_src" value="&lt;b&gt;src/  : the application&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#000066;fillColor=#F4F5FB;strokeColor=#000066;strokeWidth=2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="130.0" width="780.0" height="1140.0" as="geometry"/></mxCell><mxCell id="c_out" value="&lt;b&gt;Beside src/   (not application code)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#475569;fillColor=#F5F6F8;strokeColor=#475569;strokeWidth=2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="860.0" y="130.0" width="340.0" height="484.0" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b style=&quot;font-size:11px&quot;&gt;Five import rules (checked by the linter)&lt;/b&gt;&lt;br&gt;1. app/ and components/ may import a module only through its index.ts&lt;br&gt;or actions.ts, never repo.ts.&lt;br&gt;2. Only service.ts uses a lib/ adapter. Only repo.ts uses db.ts.&lt;br&gt;3. A module may import another module's index.ts. Never its repo.ts or&lt;br&gt;schema.ts.&lt;br&gt;4. lib/ imports nothing from modules/ or app/.&lt;br&gt;5. iam, org and platform form one kernel (they know each other). Events&lt;br&gt;with onboard and with outreach talk only through service calls and ids&lt;br&gt;(see B03)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="860.0" y="644.0" width="340.0" height="150.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;K01  ·  Package diagram: the code folders and who may import whom&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="1010.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="UML: component and package   |   Where every class lives in the repository and which direction imports are allowed   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="1010.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1090.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="c_app" value="&lt;b&gt;app/   Routes only: they ask, they do not decide&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#0F766E;fillColor=#F0FAF7;strokeColor=#0F766E;strokeWidth=2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="c_src"><mxGeometry x="20.0" y="40.0" width="740.0" height="232.0" as="geometry"/></mxCell><mxCell id="c_cmp" value="&lt;b&gt;components/   Pieces of screen: no rules, no database&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#0369A1;fillColor=#EFF8FD;strokeColor=#0369A1;strokeWidth=2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="c_src"><mxGeometry x="20.0" y="332.0" width="740.0" height="112.0" as="geometry"/></mxCell><mxCell id="c_mod" value="&lt;b&gt;modules/&amp;lt;area&amp;gt;/   One folder per business area (nine areas)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#7E22CE;fillColor=#F7F1FC;strokeColor=#7E22CE;strokeWidth=2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="c_src"><mxGeometry x="20.0" y="504.0" width="740.0" height="376.0" as="geometry"/></mxCell><mxCell id="c_lib" value="&lt;b&gt;lib/   One adapter per outside tool: only services import these&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#A16207;fillColor=#FBF6E8;strokeColor=#A16207;strokeWidth=2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="c_src"><mxGeometry x="20.0" y="922.0" width="740.0" height="192.0" as="geometry"/></mxCell><mxCell id="ou0" value='&lt;b style="font-size:10px"&gt;drizzle/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px;color:#64748B"&gt;&lt;i&gt;SQL migrations made by drizzle-kit&lt;/i&gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=5;rounded=1;arcSize=15;" vertex="1" parent="c_out"><mxGeometry x="16.0" y="46.0" width="308.0" height="40.0" as="geometry"/></mxCell><mxCell id="ou1" value='&lt;b style="font-size:10px"&gt;messages/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:9px;color:#64748B"&gt;&lt;i&gt;en.json and sw.json: interface words&lt;/i&gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=5;rounded=1;arcSize=15;" vertex="1" parent="c_out"><m