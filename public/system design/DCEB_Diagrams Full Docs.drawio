height="60.0" as="geometry"/></mxCell><mxCell id="ac_RoleAssignment_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1204.5" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_RoleAssignment_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="141.3" y="1204.5" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="acc_AuditLog" value="&lt;b&gt;Who may do what on AuditLog   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1266.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_AuditLog_super" value="Super: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1294.5" width="61.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_AuditLog_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="119.7" y="1294.5" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="n1_StaffProfile" value="&lt;b style=&quot;font-size:11px&quot;&gt;StaffProfile – in plain words&lt;/b&gt;&lt;br&gt;The staff member's name-badge details.&lt;br&gt;Church-specific facts about a staff member, kept apart from the auth&lt;br&gt;table." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1356.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n2_StaffProfile" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• 1:1 with User.&lt;br&gt;• leaderId links a staff member to their public leader profile when they&lt;br&gt;have one.&lt;br&gt;• One profile per staff User: display name, phone, photo, bio shown on&lt;br&gt;leader pages (only if showPublic = true).&lt;br&gt;• Deactivating a staff member sets active=false; the User row stays so&lt;br&gt;the audit trail still has a name.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1356.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n3_StaffProfile" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Showing staff phone numbers publicly by default.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1356.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n1_RoleAssignment" value='&lt;b style="font-size:11px"&gt;RoleAssignment – in plain words&lt;/b&gt;&lt;br&gt;A sticker that says "Grace may edit sermons at Eastern Bypass".&lt;br&gt;"Grace is a Content Editor for Eastern Bypass." One row = one role in&lt;br&gt;one scope. A person can hold several.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1500.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n2_RoleAssignment" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• scopeType = global | branch | department; branchId / departmentId&lt;br&gt;must match the scope (CHECK constraint).&lt;br&gt;• Unique on (user, role, scope, branch, department) so nobody gets the&lt;br&gt;same role twice.&lt;br&gt;• Branch Admins can only grant roles inside their own branch; only&lt;br&gt;Super Admin grants global roles.&lt;br&gt;• Every grant/revoke writes an AuditLog row.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1500.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n3_RoleAssignment" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Putting a single "role" column on the user. A department leader who&lt;br&gt;also edits blogs needs two assignments.&lt;br&gt;• Forgetting expiresAt for temporary helpers (e.g. conference&lt;br&gt;volunteers).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1500.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n1_AuditLog" value="&lt;b style=&quot;font-size:11px&quot;&gt;AuditLog – in plain words&lt;/b&gt;&lt;br&gt;The church's security-camera footage for the database.&lt;br&gt;A tamper-evident diary: who did what, to which record, when. Essential&lt;br&gt;for money and personal data." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1644.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_AuditLog" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Append-only: no UPDATE or DELETE grants for the app role.&lt;br&gt;• Written for: grants, publishes, deletes, ledger entries and voids,&lt;br&gt;exports, PII views.&lt;br&gt;• Kept 24 months; older rows archived to R2.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1644.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_AuditLog" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Logging only creates. Deletes, exports and "viewed phone number"&lt;br&gt;are the ones you need when something goes wrong.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1644.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;A User is just a login. StaffProfile says who the person is; RoleAssignment says what they may do and WHERE (global, branch or department); AuditLog remembers every change.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1750.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B21  ·  Tab: Staff access (StaffProfile, RoleAssignment, AuditLog)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="leaderId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;startFill=0;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_StaffProfile" target="c_Leader"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="334.0" y="320.8"/><mxPoint x="334.0" y="463.5"/></Array></mxGeometry></mxCell><mxCell id