ct="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_ed" value="&lt;b&gt;Content Editor&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#B91C1C;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50.0" y="120.0" width="235.0" height="1104.0" as="geometry"/></mxCell><mxCell id="lane_sys" value="&lt;b&gt;System (server + background jobs)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#000066;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="285.0" y="120.0" width="235.0" height="1104.0" as="geometry"/></mxCell><mxCell id="lane_tr" value="&lt;b&gt;Translator / Reviewer&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#B91C1C;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="120.0" width="235.0" height="1104.0" as="geometry"/></mxCell><mxCell id="lane_vis" value="&lt;b&gt;Visitor (phone or PC)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#0F766E;fillColor=#E6F4F1;strokeColor=#0F766E;strokeWidth=1.6;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="755.0" y="120.0" width="235.0" height="1104.0" as="geometry"/></mxCell><mxCell id="st" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="156.5" y="205.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="w" value="Write the post in the language&lt;br&gt;you know (English or Kiswahili)&lt;br&gt;and press Publish" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="291.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="sv" value="Save the original text and a&lt;br&gt;fingerprint of it (source_hash)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="298.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="rd" value="Reads the page in the original&lt;br&gt;language straight away" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="788.0" y="402.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="mk" value="Create an empty row for the&lt;br&gt;other language (status: missing)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="402.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="dc" value="Machine draft switched on for this kind&lt;br&gt;of content?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="304.5" y="487.0" width="196.0" height="82.0" as="geometry"/></mxCell><mxCell id="md" value="Ask the translation engine; save&lt;br&gt;the text as machine_draft" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="610.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="q" value="Open the review queue (drafts&lt;br&gt;and missing rows)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="553.0" y="610.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="fx" value="Read both texts side by side; fix&lt;br&gt;names, verses and tone" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="553.0" y="714.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="ok" value="Is the translation right?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540.5" y="823.0" width="194.0" height="34.0" as="geometry"/></mxCell><mxCell id="rj" value="Rejected with a comment: ask&lt;br&gt;for a new draft" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="818.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="ap" value="Approve the translation" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="553.0" y="929.0" width="169.0" height="30.0" as="geometry"/></mxCell><mxCell id="pb" value="Set status approved, clear the&lt;br&gt;page cache" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="922.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="vw" value="Switches language and reads&lt;br&gt;the approved text" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="788.0" y="922.0" width="169.0" height="44.0" as="geometry"/></mxCell><mxCell id="fb" value='Until then: sees the original&lt;br&gt;language with a notice "not yet&lt;br&gt;in Kiswahili"' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="788.0" y="707.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="ch" value="Later: edits the original text" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="1137.0" width="169.0" height="30.0" as="geometry"/></mxCell><mxCell id="dr" value="Fingerprint changed: approved&lt;br&gt;goes back to needs_review and&lt;br&gt;into the queue again" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="1123.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="fn0" value="Fixed words (menu, buttons, form labels) are not in this flow. They come from message files (en.json, sw.json) that developers and the translator update together." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="50.0" y="1250.0" width="900.0" height="32.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;F05  ·  Translating dynamic content (blogs, sermons, bulletins)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="50.0" y="42.0" width="790.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Flow and block diagrams   |   One page, two languages: write once, review once, never show an unchecked translation   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="50.0" y="72.0" width="790.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="880.0" y="