rent="1"><mxGeometry x="920.0" y="422.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ob9" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#7E22CE;strokeColor=#7E22CE;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1102.0" y="420.0" width="224.0" height="22.0" as="geometry"/></mxCell><mxCell id="oc9" value="4" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#7E22CE;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="1334.0" y="422.0" width="40.0" height="22.0" as="geometry"/></mxCell><mxCell id="on10" value="Certificate" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1B2F;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="920.0" y="452.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ob10" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#0369A1;strokeColor=#0369A1;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1102.0" y="450.0" width="224.0" height="22.0" as="geometry"/></mxCell><mxCell id="oc10" value="4" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#0369A1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="1334.0" y="452.0" width="40.0" height="22.0" as="geometry"/></mxCell><mxCell id="on11" value="RoleAssignment" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1B1B2F;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="920.0" y="482.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ob11" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#000066;strokeColor=#000066;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1102.0" y="480.0" width="168.0" height="22.0" as="geometry"/></mxCell><mxCell id="oc11" value="3" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="1278.0" y="482.0" width="40.0" height="22.0" as="geometry"/></mxCell><mxCell id="spine" value='&lt;b style="font-size:11px"&gt;The spine (15 or more tables point here)&lt;/b&gt;&lt;br&gt;Branch (29), User (28), MediaAsset (20).&lt;br&gt;These three are the roots of the whole system. Change one and nearly everything changes.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="60.0" y="660.0" width="560.0" height="76.0" as="geometry"/></mxCell><mxCell id="pill" value='&lt;b style="font-size:11px"&gt;The pillars (5 to 14 tables point here)&lt;/b&gt;&lt;br&gt;Department (9), Leader (7), FormDefinition (5), Project (5).&lt;br&gt;Each one is the centre of a whole feature (church structure, forms, projects, events).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FAF1D9;strokeColor=#A16207;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="650.0" y="660.0" width="560.0" height="76.0" as="geometry"/></mxCell><mxCell id="lead" value='&lt;b style="font-size:11px"&gt;How to use the numbers&lt;/b&gt;&lt;br&gt;Design the high fan-in classes first and most carefully, test them hardest and change them last. Design the&lt;br&gt;high fan-out classes last: they only exist because the things they point at already exist. When you start the&lt;br&gt;build, create the tables in order of fan-in (Branch, User, MediaAsset ... then the rest).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240.0" y="660.0" width="520.0" height="76.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B05  ·  What is the main class? Counting who depends on whom&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="60.0" y="32.0" width="1550.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class architecture (UML)   |   Fan-in (how many tables point at a class) and fan-out (how many classes a table points at)   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="60.0" y="62.0" width="1550.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1650.0" y="36.0" width="100.0" height="28.0" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="pg_B06" name="B06 Module dependencies: the kernel and the six feature modules"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1023" pageHe