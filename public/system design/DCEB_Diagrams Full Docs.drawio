ticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="999.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_MediaAsset_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1027.5" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_MediaAsset_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="141.3" y="1027.5" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_MediaAsset_editor" value="Editor: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="238.8" y="1027.5" width="83.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_MediaAsset_translator" value="Translator: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="330.7" y="1027.5" width="81.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_MediaAsset_dept" value="Dept leader: CR" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E5F4EA;strokeColor=#15803D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="420.4" y="1027.5" width="95.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_MediaAsset_discipler" value="Discipler: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="523.4" y="1027.5" width="75.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_MediaAsset_treasurer" value="Treasurer: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="607.0" y="1027.5" width="78.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_MediaAsset_events" value="Events: CR" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE6F0;strokeColor=#BE185D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="693.9" y="1027.5" width="73.4" height="22.0" as="geometry"/></mxCell><mxCell id="n1_MediaAsset" value='&lt;b style="font-size:11px"&gt;MediaAsset – in plain words&lt;/b&gt;&lt;br&gt;The library card for one file.&lt;br&gt;Every file (image, audio, PDF, certificate) is one row pointing to a&lt;br&gt;Cloudflare R2 object. Other tables store the id, never the URL.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1089.5" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n2_MediaAsset" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Browser uploads straight to R2 with a presigned URL; the app only&lt;br&gt;stores the row.&lt;br&gt;• isPublic = false for certificates and anything with personal data; served&lt;br&gt;with short-lived signed URLs.&lt;br&gt;• checksum prevents duplicate uploads.&lt;br&gt;• status goes uploading -&amp;gt; ready (after a verification job) or failed.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1089.5" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n3_MediaAsset" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Saving the full URL. If you ever change CDN or bucket, every row&lt;br&gt;breaks. Save the key.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1089.5" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Every file (photo, PDF, audio, video link) is registered once here. Other tables only store its id.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1221.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B32  ·  Tab: MediaAsset&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helv