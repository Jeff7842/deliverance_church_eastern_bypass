12;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.6;dashed=1;dashPattern=6 4;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="12.0" y="802.0" width="208.0" height="48.0" as="geometry"/></mxCell><mxCell id="e" value="Two-factor turned on?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="204.0" y="438.0" width="216.0" height="38.0" as="geometry"/></mxCell><mxCell id="e1" value="Ask for the 6-digit code from the&lt;br&gt;phone app" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="182.0" y="520.0" width="188.0" height="48.0" as="geometry"/></mxCell><mxCell id="e2" value="Code right?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="216.0" y="612.0" width="120.0" height="38.0" as="geometry"/></mxCell><mxCell id="f" value="Create the session: 7 days, secure&lt;br&gt;httpOnly cookie, saved in the&lt;br&gt;database" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="253.0" y="694.0" width="202.0" height="64.0" as="geometry"/></mxCell><mxCell id="g" value="Load the person's roles&lt;br&gt;(RoleAssignment: role + scope:&lt;br&gt;global, branch, department)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=cent