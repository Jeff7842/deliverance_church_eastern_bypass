" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="156.5" y="205.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="cs" value="Said Yes to the new-member&lt;br&gt;question (F02). Reads the&lt;br&gt;consent text and ticks the box" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="291.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="jr" value="Save consent; create the&lt;br&gt;journey at step 1; give a private&lt;br&gt;token" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="291.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="s2" value="Steps 2 to 8: one short screen&lt;br&gt;each (about me, who we are,&lt;br&gt;leaders, departments,&lt;br&gt;fellowship, programmes, giving)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="83.0" y="389.0" width="169.0" height="70.0" as="geometry"/></mxCell><mxCell id="sv" value="After each step: save the&lt;br&gt;answers and the current step&lt;br&gt;(resume works)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="318.0" y="395.0" width="169.0" height="58.0" as="geometry"/></mxCell><mxCell id="ch" value="Wants Christ or a team?" style="whiteSpace=wrap;html=1;fontF