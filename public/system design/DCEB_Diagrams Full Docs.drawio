etry"/></mxCell><mxCell id="ac_ProjectUpdate_treasurer" value="Treasurer: CR" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FAF1D9;strokeColor=#A16207;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="395.7" y="626.0" width="86.1" height="22.0" as="geometry"/></mxCell><mxCell id="acc_ProjectMedia" value="&lt;b&gt;Who may do what on ProjectMedia   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="688.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMedia_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="716.0" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMedia_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="716.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMedia_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="213.6" y="716.0" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ProjectMedia_editor" value="Editor: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="311.1" y="716.0" width="83.9" height="22.0" as="geometry"/></mxCell><mxCell id="n1_ProjectUpdate" value='&lt;b style="font-size:11px"&gt;ProjectUpdate – in plain words&lt;/b&gt;&lt;br&gt;A progress note with a date.&lt;br&gt;The "latest news" log at the bottom of a project page; also gives the&lt;br&gt;"last updated" date.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="778.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_ProjectUpdate" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• A dated post ("Roofing completed") with optional photos; its createdAt&lt;br&gt;feeds the "last updated" label.&lt;br&gt;• Public. Written by Branch Admin or Content Editor.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="778.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_ProjectUpdate" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Forgetting to update: a stale "last updated" date kills donor trust faster&lt;br&gt;than no page at all.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="778.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_ProjectMedia" value='&lt;b style="font-size:11px"&gt;ProjectMedia – in plain words&lt;/b&gt;&lt;br&gt;Photos for the project page.&lt;br&gt;Photo gallery of a project.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="872.0" width="337.3" height="58.0" as="geometry"/></mxCell><mxCell id="n2_ProjectMedia" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Link table between Project and MediaAsset with sortOrder and caption&lt;br&gt;(translatable).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="872.0" width="337.3" height="58.0" as="geometry"/></mxCell><mxCell id="n3_ProjectMedia" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Uploading full 6MB camera photos. Resize on upload&lt;br&gt;(StorageService).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="872.0" width="337.3" height="58.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Updates give the "last updated" date and the story; media gives photos.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="952.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id