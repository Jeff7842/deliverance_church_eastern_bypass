olor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ProgrammeCohort"><mxGeometry x="0.0" y="82.5" width="252.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_ProgrammeCohort_a4" value="… +10 more" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ProgrammeCohort"><mxGeometry x="0.0" y="99.0" width="252.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_ProgrammeEnrollment" value="ProgrammeEnrollment" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=29;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#BE185D;strokeColor=#BE185D;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760.0" y="567.5" width="252.0" height="119.5" as="geometry"/></mxCell><mxCell id="c_ProgrammeEnrollment_a0" value="+ id: uuid {PK}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ProgrammeEnrollment"><mxGeometry x="0.0" y="33.0" width="252.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_ProgrammeEnrollment_a1" value="+ cohortId: uuid {FK→ProgrammeCohort}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ProgrammeEnrollment"><mxGeometry x="0.0" y="49.5" width="252.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_ProgrammeEnrollment_a2" value="+ convertId: uuid {FK→Convert}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ProgrammeEnrollment"><mxGeometry x="0.0" y="66.0" width="252.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_ProgrammeEnrollment_a3" value="+ origin: EnrollOrigin" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ProgrammeEnrollment"><mxGeometry x="0.0" y="82.5" width="252.0" height="16.5" as="geometry"/></mxCell><mxCell id="c_ProgrammeEnrollment_a4" value="… +3 more" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_ProgrammeEnrollment"><mxGeometry x="0.0" y="99.0" width="252.0" height="16.5" as="geometry"/></mxCell><mxCell id="svc_box" value="&lt;b&gt;Depends on (platform code this class calls)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#F4F4F5;strokeColor=#334155;strokeWidth=1.5;dashed=1;dashPattern=6 4;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1174.5" width="1060.0" height="62.0" as="geometry"/></mxCell><mxCell id="sv_0" value="RateLimiter" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1202.5" width="77.0" height="22.0" as="geometry"/></mxCell><mxCell id="sv_1" value="JobQueue" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="135.0" y="1202.5" width="70.9" height="22.0" as="geometry"/></mxCell><mxCell id="sv_2" value="Mailer" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="213.9" y="1202.5" width="50.9" height="22.0" as="geometry"/></mxCell><mxCell id="acc_Convert" value="&lt;b&gt;Who may do what on Convert   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1260.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_Convert_visitor" value="Visitor: S" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1288.5" width="63.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Convert_newmember" value="New member: S" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="121.7" y="1288.5" width="95.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Convert_super" value="Super: RX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="224.8" y="1288.5" width="68.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Convert_branch" value="Branch: RX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="301.1" y="1288.5" width="74.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Convert_discipler" value="Discipler: RUX" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="383.6" y="1288.5" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="acc_FollowUpCase" value="&lt;b&gt;Who may do what on FollowUpCase   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1350.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_FollowUpCase_super" value="Super: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1378.5" width="68.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FollowUpCase_branch" value="Branch: RUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="126.9" y="1378.5" width="82.2" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FollowUpCase_discipler" value="Discipler: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="217.1" y="1378.5" width="97.2" height="22.0" as="geometry"/></mxCell><mxCell id="acc_ContactAttempt" value="&lt;b&gt;Who may do what on ContactAttempt   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1440.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_ContactAttempt_super" value="Super: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1468.5" width="61.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ContactAttempt_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="119.7" y="1468.5" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ContactAttempt_discipler" value="Discipler: CRU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F2E7FB;strokeColor=#7E22CE;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="195.5" y="1468.5" width="90.0" height="22.0" as="geometry"/></mxCell><mxCell id="n1_Convert" value='&lt;b style="font-size:11px"&gt;Convert – in plain words&lt;/b&gt;&lt;br&gt;A person who just said yes to Jesus and wants someone to call.&lt;br&gt;A decision to follow Christ, recorded with a name and phone so the&lt;br&gt;discipleship team can reach out. This is the data behind the "born&lt;br&gt;again" counter.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1530.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n2_Convert" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Belief is SENSITIVE personal data in Kenya: explicit consent text must&lt;br&gt;be shown and stored (consentAt + consentVersion).&lt;br&gt;• dedupeKey = hash(normalised phone) stops double counting.&lt;br&gt;• The public counter = count(isCounted) + SiteSetting baseline.&lt;br&gt;• Visible only to Discipler(s) of that branch, Branch Admin and Super&lt;br&gt;Admin.&lt;br&gt;• A FollowUpCase is opened automatically.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1530.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n3_Convert" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Counting every "I am already born again" tick from the new-member&lt;br&gt;tour. That is a profile fact, not a new decision.&lt;br&gt;• Showing the converts list to every editor. Least privilege: only&lt;br&gt;disciplers.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1530.5" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n1_FollowUpCase" value='&lt;b style="font-size:11px"&gt;FollowUpCase – in plain words&lt;/b&gt;&lt;br&gt;The folder a discipler keeps for each new believer.&lt;br&gt;The care file for one convert: who is responsible, how many attempts,&lt;br&gt;where they are on the journey.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1674.5" width="337.3" height="148.0" as="geometry"/></mxCell><mxCell id="n2_FollowUpCase" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Target: first contact within 48 hours (dueAt); QStash reminds the&lt;br&gt;discipler and escalates to the Branch Admin if overdue.&lt;br&gt;• 1:1 with Convert.&lt;br&gt;• Closing needs a reason (enrolled, completed, declined, unreachable).&lt;br&gt;• Created automatically when a Convert row is created; assigned to a&lt;br&gt;Discipler of that branch.&lt;br&gt;• Status: new -&amp;gt; contacting -&amp;gt; connected -&amp;gt; in_programme -&amp;gt; closed. A&lt;br&gt;case can reopen.&lt;br&gt;• Reminder jobs run through QStash (day 1, day 3, day 7).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1674.5" width="337.3" height="148.0" as="geometry"/></mxCell><mxCell id="n3_FollowUpCase" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Assigning one Discipler to everything: when they are away, nobody&lt;br&gt;calls the new believer.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1674.5" width="337.3" height="148.0" as="geometry"/></mxCell><mxCell id="n1_ContactAttempt" value='&lt;b style="font-size:11px"&gt;ContactAttempt – in plain words&lt;/b&gt;&lt;br&gt;A line in the care diary.&lt;br&gt;Each call, SMS or visit, with the result.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1844.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n2_ContactAttempt" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Notes are private to disciplers and above; never exported by default.&lt;br&gt;• Append-only log: channel (call, SMS, WhatsApp, visit), outcome, note,&lt;br&gt;who, when.&lt;br&gt;• Only the assigned Discipler, Branch Admin and Super Admin can read&lt;br&gt;notes.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1844.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n3_ContactAttempt" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Editing past notes. A log you can rewrite is not a log.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1844.5" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Three steps: someone is recorded (Convert), a case is opened for a Discipler (FollowUpCase), each call is logged (ContactAttempt).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1964.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B39  ·  Tab: Go Ye follow-up (Convert, FollowUpCase, ContactAttempt)&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=