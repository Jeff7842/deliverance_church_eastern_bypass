 height="22.0" as="geometry"/></mxCell><mxCell id="a" value="Visitor asks for a web address (for&lt;br&gt;example /sw/mahubiri/imani)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6F4F1;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="404.0" y="78.0" width="198.0" height="48.0" as="geometry"/></mxCell><mxCell id="b" value="Address starts with /en or /sw?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="391.0" y="170.0" width="224.0" height="66.0" as="geometry"/></mxCell><mxCell id="b1" value="Proxy picks a language (saved&lt;br&gt;choice, then browser language, else&lt;br&gt;English) and redirects to&lt;br&gt;/&amp;lt;language&amp;gt;/... (307)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="312.0" y="280.0" width="210.0" height="78.0" as="geometry"/></mxCell><mxCell id="c" value='Ask the cache for this page: tag&lt;br&gt;"sermon:ID" + language' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="416.0" y="402.0" width="186.0" height="48.0" as="geometry"/></mxCell><mxCell id="c1" value="Found in cache?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="426.0" y="494.0" width="166.0" height="38.0" as="geometry"/></mxCell><mxCell id="c2" value="Read the item and its translation&lt;br&gt;row for this language from Postgres" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FAF1D9;strokeColor=#A16207;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="41.0" y="576.0" width="206.0" height="48.0" as="geometry"/></mxCell><mxCell id="d" value="Does the item exist and is it&lt;br&gt;published?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="49.0" y="668.0" width="190.0" height="66.0" as="geometry"/></mxCell><mxCell id="d1" value='Show the "page not found" screen&lt;br&gt;in the same language, with links to&lt;br&gt;the home page and search' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="12.0" y="1031.0" width="200.0" height="64.0" as="geometry"/></mxCell><mxCell id="e" value="Is the translation for this language&lt;br&gt;approved?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="138.0" y="778.0" width="196.0" height="94.0" as="geometry"/></mxCell><mxCell id="e1" value="Render in this language" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="131.0" y="932.0" width="144.0" height="32.0" as="geometry"/></mxCell><mxCell id="e2" value='Render in the other language with a&lt;br&gt;small notice: "This page is not yet&lt;br&gt;available in Kiswahili"' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E4F1FA;strokeColor=#0369A1;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="311.0" y="916.0" width="208.0" height="64.0" as="geometry"/></mxCell><mxCell id="f" value="Add the page head: title,&lt;br&gt;description, canonical address,&lt;br&gt;hreflang links only for languages&lt;br&gt;that really exist and are approved" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="286.0" y="1024.0" width="194.0" height="78.0" as="geometry"/></mxCell><mxCell id="g" value="Store in the cache; send the page&lt;br&gt;(HTML first, video only after a tap)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="317.0" y="1146.0" width="198.0" height="48.0" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="103.0" y="1238.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;F04  ·  One page request: language, cache and fallback&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="12.0" y="-66.0" width="700.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Flow and block diagrams   |   How the site chooses English or Kiswahili and what it does when a translation is