ll><mxCell id="ac_Series_translator" value="Translator: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FDEEE3;strokeColor=#C2410C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="539.5" y="1048.5" width="88.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Series_dept" value="Dept leader: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="636.4" y="1048.5" width="87.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Series_discipler" value="Discipler: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="732.2" y="1048.5" width="75.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Series_treasurer" value="Treasurer: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="815.8" y="1048.5" width="78.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Series_events" value="Events: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="902.7" y="1048.5" width="66.1" height="22.0" as="geometry"/></mxCell><mxCell id="acc_Minister" value="&lt;b&gt;Who may do what on Minister   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1110.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_Minister_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1138.5" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_newmember" value="New member: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1138.5" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_super" value="Super: CRUDPA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="225.9" y="1138.5" width="96.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_branch" value="Branch: CRUDPA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="330.3" y="1138.5" width="102.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_editor" value="Editor: CRUDP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="441.0" y="1138.5" width="90.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_translator" value="Translator: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FDEEE3;strokeColor=#C2410C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="539.5" y="1138.5" width="88.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_dept" value="Dept leader: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="636.4" y="1138.5" width="87.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_discipler" value="Discipler: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="732.2" y="1138.5" width="75.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_treasurer" value="Treasurer: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="815.8" y="1138.5" width="78.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Minister_events" value="Events: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="902.7" y="1138.5" width="66.1" height="22.0" as="geometry"/></mxCell><mxCell id="acc_Topic" value="&lt;b&gt;Who may do what on Topic   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1200.5" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_Topic_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1228.5" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_newmember" value="New member: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1228.5" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_super" value="Super: CRUDPA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="225.9" y="1228.5" width="96.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_branch" value="Branch: CRUDPA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="330.3" y="1228.5" width="102.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_editor" value="Editor: CRUDP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="441.0" y="1228.5" width="90.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_translator" value="Translator: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FDEEE3;strokeColor=#C2410C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="539.5" y="1228.5" width="88.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_dept" value="Dept leader: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="636.4" y="1228.5" width="87.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_discipler" value="Discipler: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="732.2" y="1228.5" width="75.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_treasurer" value="Treasurer: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="815.8" y="1228.5" width="78.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Topic_events" value="Events: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="902.7" y="1228.5" width="66.1" height="22.0" as="geometry"/></mxCell><mxCell id="n1_Series" value='&lt;b style="font-size:11px"&gt;Series – in plain words&lt;/b&gt;&lt;br&gt;A playlist of sermons.&lt;br&gt;A run of connected messages (e.g. "Faith that Moves").' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1290.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_Series" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Sermon.seriesPart orders the sermons inside a series.&lt;br&gt;• A series has a start and end date; sermons attach to it with seriesPart&lt;br&gt;(1, 2, 3...).&lt;br&gt;• Series with no sermons is hidden from filters.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1290.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_Series" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Creating a series per sermon. A series is a run of 2 or more.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1290.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n1_Minister" value="&lt;b style=&quot;font-size:11px&quot;&gt;Minister – in plain words&lt;/b&gt;&lt;br&gt;A preacher who can have many sermons.&lt;br&gt;The speaker. Clicking a minister's name filters every sermon by that&lt;br&gt;person, so Minister must be its own record." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1396.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_Minister" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• leaderId is optional because guest ministers are not church leaders.&lt;br&gt;• Merge duplicates ("Pr. John" vs "Pastor John Kamau") before launch,&lt;br&gt;never after.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1396.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_Minister" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Free-text speaker names on sermons. You cannot filter or link what&lt;br&gt;you did not model.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1396.5" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n1_Topic" value='&lt;b style="font-size:11px"&gt;Topic – in plain words&lt;/b&gt;&lt;br&gt;A label that can be stuck on many things.&lt;br&gt;The reusable "category dictionary". Resource topics, sermon themes&lt;br&gt;and blog categories are all Topics, so a topic typed once can be reused&lt;br&gt;forever.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1490.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_Topic" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• taxonomy separates theme / resource_topic / blog_category so lists&lt;br&gt;stay tidy.&lt;br&gt;• Editors pick from existing topics first; creating a new one is one click&lt;br&gt;but needs a Swahili name before publish.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1490.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_Topic" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Typing categories as free text on every upload ("Prayer", "prayer",&lt;br&gt;"Prayers"). That is why you wanted a topic table, and you were right.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1490.5" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;These three are the "filters" of the Sermons page: clicking a minister, a series or a theme narrows the list.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1596.5" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B27  ·  Tab: Series, Minister, Topic&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell 