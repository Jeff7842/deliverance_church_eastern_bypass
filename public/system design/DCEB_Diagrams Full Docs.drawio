;fontSize=10;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="30.0" y="640.0" width="260.0" height="18.0" as="geometry"/></mxCell><mxCell id="sp15" value="Phase 3: steps 2 to 8 (one short screen each)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="30.0" y="840.0" width="260.0" height="18.0" as="geometry"/></mxCell><mxCell id="fr3" value="&lt;b&gt;loop  [each step]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#7E22CE;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50.0" y="870.0" width="1050.0" height="128.0" as="geometry"/></mxCell><mxCell id="fr4" value="&lt;b&gt;opt  [wants to be born again / needs a believer]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#0369A1;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50.0" y="1014.0" width="1050.0" height="94.0" as="geometry"/></mxCell><mxCell id="fr5" value="&lt;b&gt;opt  [wants to join a department or fellowship]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#0369A1;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50.0" y="1124.0" width="1050.0" height="60.0" as="geometry"/></mxCell><mxCell id="sp19" value="Phase 4: finish" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="30.0" y="1200.0" width="260.0" height="18.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;S04  ·  New-member tour: ask, consent, save, finish&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="30.0" y="22.0" width="1115.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value='UML: sequence   |   The "No is remembered locally" rule and the first server contact   |   Phase 1' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="30.0" y="52.0" width="1115.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1185.0" y="26.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="msg0" value="1. opens the home page" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="222.0" as="sourcePoint"/><mxPoint x="355.0" y="222.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg1" value='2. Read localStorage "dceb_tour = no" (and cookie if accepted)' style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;edgeStyle=none;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="256.0" as="sourcePoint"/><mxPoint x="365.0" y="278.0" as="targetPoint"/><Array as="points"><mxPoint x="399.0" y="256.0"/><mxPoint x="399.0" y="278.0"/></Array></mxGeometry></mxCell><mxCell id="msg2" value='Modal: "Are you new here? Take a tour?" [Yes] [No]' style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#64748B;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355.0" y="344.0" as="sourcePoint"/><mxPoint x="150.0" y="344.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg3" value="4. press No" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="490.0" as="sourcePoint"/><mxPoint x="355.0" y="490.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg4" value='5. Save "no" locally (cookie only if cookies accepted)' style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;edgeStyle=none;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365.0" y="524.0" as="sourcePoint"/><mxPoint x="365.0" y="546.0" as="targetPoint"/><Array as="points"><mxPoint x="399.0" y="524.0"/><mxPoint x="399.0" y="546.0"/></Array></mxGeometry></mxCell><mxCell id="msg5" value="6. press Yes" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="598.0" as="sourcePoint"/><mxPoint x="355.0" y="598.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg6" value="7. startTour(branch, ageGroup, consent = true, policyVersion)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="678.0" as="sourcePoint"/><mxPoint x="570.0" y="678.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg7" value='8. limit("tour:" + ipHash, 10 per hour)' style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580.0" y="712.0" as="sourcePoint"/><mxPoint x="785.0" y="712.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg8" value="ok" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#64748B;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785.0" y="746.0" as="sourcePoint"/><mxPoint x="580.0" y="746.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg9" value="10. INSERT consent_record; INSERT new_member_journey(step = 1)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580.0" y="780.0" as="sourcePoint"/><mxPoint x="1000.0" y="780.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg10" value="journey token (httpOnly cookie) + step 2 form" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#64748B;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="814.0" as="sourcePoint"/><mxPoint x="150.0" y="814.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg11" value="12. saveStep(token, step, answers)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="904.0" as="sourcePoint"/><mxPoint x="570.0" y="904.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg12" value="13. UPDATE journey.currentStep; UPSERT new_member_profile" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580.0" y="938.0" as="sourcePoint"/><mxPoint x="1000.0" y="938.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg13" value="next step (resume works after refresh)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#64748B;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="972.0" as="sourcePoint"/><mxPoint x="150.0" y="972.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg14" value="15. INSERT convert (origin = tour) + follow_up_case" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580.0" y="1048.0" as="sourcePoint"/><mxPoint x="1000.0" y="1048.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg15" value="16. notify the branch Disciplers" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580.0" y="1082.0" as="sourcePoint"/><mxPoint x="1215.0" y="1082.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg16" value="17. INSERT join_request(type, department or fellowship)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580.0" y="1158.0" as="sourcePoint"/><mxPoint x="1000.0" y="1158.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg17" value="18. submitFeedback(answers)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="1238.0" as="sourcePoint"/><mxPoint x="570.0" y="1238.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg18" value="19. INSERT feedback_response; journey.status = completed" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580.0" y="1272.0" as="sourcePoint"/><mxPoint x="1000.0" y="1272.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg19" value="20. enqueue make-certificate(journeyId)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><m