></mxCell></object><mxCell id="msg0" value="1. GET /sw/mahubiri/imani-inayosogeza" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="234.0" as="sourcePoint"/><mxPoint x="345.0" y="234.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg1" value="2. Ask the Next cache for tag sermon:ID + locale" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;edgeStyle=none;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355.0" y="268.0" as="sourcePoint"/><mxPoint x="355.0" y="290.0" as="targetPoint"/><Array as="points"><mxPoint x="389.0" y="268.0"/><mxPoint x="389.0" y="290.0"/></Array></mxGeometry></mxCell><mxCell id="msg2" value="3. SELECT sermon + sermon_translation(locale) with fallback to the other language" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#475569;strokeWidth=1.4;rounded=0;curved=0;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355.0" y="344.0" as="sourcePoint"/><mxPoint x="960.0" y="344.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg3" value="row + translations" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;fontSize=10;strokeColor=#64748B;strokeWidth=1.4;rounded=0;curved=0;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960.0" y="378.0" as="sourcePoint"/><mxPoint x="355.0" y="378.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="msg4" value="HTML: thumbnail, summary, verses, key points (YouTube iframe NOT loaded yet)" style="html=1;verticalAlign=bottom;labelBackg