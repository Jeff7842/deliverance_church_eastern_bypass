<mxfile host="app.diagrams.net" modified="2026-10-09T00:00:00.000Z" agent="DCEB design set" version="24.7.0" type="device"><diagram id="INDEX" name="00 Index"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1804" pageHeight="1914" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ix_t" value='&lt;b style="font-size:26px"&gt;DCEB website: system design diagram set&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="30.0" width="1500.0" height="36.0" as="geometry"/></mxCell><mxCell id="ix_s" value="Deliverance Church Eastern Bypass  |  125 diagrams on 126 pages  |  every shape is editable and every arrow is a real connector" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="70.0" width="1500.0" height="22.0" as="geometry"/></mxCell><mxCell id="ix_h" value='How to use this file: (1) click a chip below to open a page, (2) press the navy "Index" button on any page to return, (3) drag any box and its arrows follow, (4) the Layers panel on B01 shows or hides one role at a time. Colours: teal = public, red = staff, purple = discipler, blue = new member, gold = treasurer, green = department leader, navy = super admin, orange =&lt;br&gt;translator.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="102.0" width="1724.0" height="46.0" as="geometry"/></mxCell><mxCell id="ixc1" value="&lt;b&gt;Class architecture (UML)  ·  20&lt;/b&gt;" style