or=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="788.0" width="90.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FormDefinition_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="148.0" y="788.0" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FormDefinition_editor" value="Editor: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="223.8" y="788.0" width="69.4" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FormDefinition_dept" value="Dept leader: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E5F4EA;strokeColor=#15803D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="301.2" y="788.0" width="95.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FormDefinition_events" value="Events: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE6F0;strokeColor=#BE185D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="404.3" y="788.0" width="73.4" height="22.0" as="geometry"/></mxCell><mxCell id="acc_FormField" value="&lt;b&gt;Who may do what on FormField   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="850.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_FormField_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="878.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FormField_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="141.3" y="878.0" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FormField_dept" value="Dept leader: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E5F4EA;strokeColor=#15803D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="217.1" y="878.0" width="95.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_FormField_events" value="Events: RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FBE6F0;strokeColor=#BE185D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="320.2" y="878.0" width="73.4" height="22.0" as="geometry"/></mxCell><mxCell id="n1_FormDefinition" value='&lt;b style="font-size:11px"&gt;FormDefinition – in plain words&lt;/b&gt;&lt;br&gt;A blank form that staff can design.&lt;br&gt;A small form builder. Event registrations, programme enrolment,&lt;br&gt;department follow-up questions and mission applications all use it.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="940.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n2_FormDefinition" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• A published form is immutable: edits create version + 1, old&lt;br&gt;submissions keep their version.&lt;br&gt;• Fields support conditional visibility (showIf).&lt;br&gt;• Describes a configurable form (new-member tour questions,&lt;br&gt;programme enrolment questions).&lt;br&gt;• Version number increases on every publish; old answers keep the&lt;br&gt;version they were collected under.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="940.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n3_FormDefinition" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Editing a published form in place: old answers no longer match the&lt;br&gt;questions. Always publish a new version.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="940.0" width="337.3" height="122.0" as="geometry"/></mxCell><mxCell id="n1_FormField" value='&lt;b style="font-size:11px"&gt;FormField – in plain words&lt;/b&gt;&lt;br&gt;One question on the form.&lt;br&gt;One question on a form. Labels and options are small JSON objects&lt;br&gt;with an English and a Kiswahili text.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1084.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n2_FormField" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Field types: text, textarea, select, radio, checkbox, date, phone, email,&lt;br&gt;consent.&lt;br&gt;• Labels and help texts are JSONB per locale: {"en": "...", "sw": "..."}.&lt;br&gt;• Conditional rule "showIf" is stored as a small JSON expression,&lt;br&gt;evaluated by one shared function on server and client.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1084.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="n3_FormField" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Storing the label as the answer key. Use the field id, so renaming a&lt;br&gt;label does not orphan answers.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1084.0" width="337.3" height="98.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;The new-member tour questions and the programme enrolment questions are data, so the church can change them without a programmer.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1204.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B43  ·  Tab: Form b