146.0" y="1066.0" width="92.0" height="86.0" as="geometry"/></mxCell><mxCell id="howto" value='&lt;b style="font-size:11px"&gt;How to read this page&lt;/b&gt;&lt;br&gt;• A stick figure is a PERSON or an outside SERVICE that uses the system.&lt;br&gt;• An oval is one thing they can do (a use case).&lt;br&gt;• A grey frame groups ovals. A line from an actor to a frame means the actor takes part in EVERY oval inside it. A line to one oval means&lt;br&gt;only that oval.&lt;br&gt;• A dashed purple arrow means "this oval always uses that one" (include) or "may add this step" (extend).&lt;br&gt;• The dashed outline is the edge of our website; anything outside it is not ours.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="1336.0" width="640.0" height="112.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;U03  ·  New member: the tour&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="72.0" width="1048.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="UML: use cases   |   Yes/No question, nine short steps, feedback and the certificate   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="102.0" width="1048.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;