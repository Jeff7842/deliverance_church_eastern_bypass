" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;startFill=0;exitX=1.000;exitY=0.667;exitDx=0;exitDy=0;entryX=0.000;entryY=0.333;entryDx=0;entryDy=0;" edge="1" parent="1" source="us" target="pb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="402.5" y="953.7"/><mxPoint x="402.5" y="1040.7"/></Array></mxGeometry></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.4;endArrow=block;endFill=1;startArrow=none;startFill=0;exitX=0.000;exitY=0.667;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="pb" target="e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="366.8" y="1055.3"/><mxPoint x="366.8" y="1152.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg_F15" name="F15 Privacy request and security incident"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1266" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sa" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="396.0" y="12.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="a" value='A person asks: "what do you hold&lt;br&gt;about me?", "delete my data" or&lt;br&gt;"correct this" (form, e-mail, or&lt;br&gt;"Withdraw consent" in the tour)' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6F4F1;strokeColor=#0F766E;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="310.0" y="74.0" width="194.0" height="78.0" as="geometry"/></mxCell><mxCell id="b" value="Log the request: date, who, what.&lt;br&gt;Start the clock (legal time limit:&lt;br&gt;verify with a lawyer)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="310.0" y="192.0" width="194.0" height="64.0" as="geometry"/></mxCell><mxCell id="c" value="Confirm identity by replying to the&lt;br&gt;e-mail or phone they gave when&lt;br&gt;they joined" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="309.0" y="296.0" width="196.0" height="64.0" as="geometry"/></mxCell><mxCell id="d" value="Identity confirmed?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="313.0" y="406.7" width="188.0" height="38.0" as="geometry"/></mxCell><mxCell id="d1" value="Ask for more proof, or decline&lt;br&gt;politely and record why" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="12.0" y="497.0" width="174.0" height="48.0" as="geometry"/></mxCell><mxCell id="e" value="What do they want?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340.0" y="509.0" width="196.0" height="38.0" as="geometry"/></mxCell><mxCell id="e1" value="Export what the system holds for&lt;br&gt;that person (journey, profile,&lt;br&gt;consents, requests)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="118.0" y="601.0" width="192.0" height="64.0" as="geometry"/></mxCell><mxCell id="e2" value="Anonymise: remove name, phone&lt;br&gt;and e-mail; keep counts and the&lt;br&gt;money ledger" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="340.0" y="601.0" width="196.0" height="64.0" as="geometry"/></mxCell><mxCell id="e3" value="Correct the field and write the&lt;br&gt;change in the audit log" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="566.0" y="609.0" width="174.0" height="48.0" as="geometry"/></mxCell><mxCell id="f" value="Reply to the person; mark the&lt;br&gt;request closed; log it" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="334.0" y="716.0" width="174.0" height="48.0" as="geometry"/></mxCell><mxCell id="sb" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="898.0" y="130.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="g" value="Someone suspects a leak: lost&lt;br&gt;laptop, wrong e-mail sent, hacked&lt;br&gt;account, exposed key" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="811.0" y="192.0" width="196.0" height="64.0" as="geometry"/></mxCell><mxCell id="h" value="Contain it at once: sign out all&lt;br&gt;sessions, rotate keys, disable the&lt;br&gt;account" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="812.0" y="296.0" width="194.0" height="64.0" as="geometry"/></mxCell><mxCell id="i" value="Write down what happened, when,&lt;br&gt;which data, who may be affected" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="809.0" y="400.0" width="200.0" height="48.0" as="geometry"/></mxCell><mxCell id="j" value="Personal data at risk of harm?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;rhombus;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="808.0" y="488.0" width="202.0" height="66.0" as="geometry"/></mxCell><mxCell id="k" value="Tell the Data Protection&lt;br&gt;Commissioner within 72 hours, and&lt;br&gt;tell the people affected without delay&lt;br&gt;(verify with a lawyer)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="770.0" y="594.0" width="210.0" height="78.0" as="geometry"/></mxCell><mxCell id="l" value="Record it in the incident log only" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#FBE9E9;strokeColor=#B91C1C;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="1010.0" y="617.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="m" value="Fix the cause, add a test, and tell&lt;br&gt;the staff what changed" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="810.0" y="716.0" width="194.0" height="48.0" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="412.0" y="804.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;F15  ·  Privacy request and security incident&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="12.0" y="-66.0" width="1036.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Flow and block diagrams   |   What the church does when a person asks about their data, and when something goes wrong   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="12.0" y="-36.0" width="1036.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=m