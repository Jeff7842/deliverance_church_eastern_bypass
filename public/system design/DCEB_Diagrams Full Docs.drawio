=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="539.5" y="1040.0" width="88.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Announcement_dept" value="Dept leader: CU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E5F4EA;strokeColor=#15803D;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="636.4" y="1040.0" width="95.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Announcement_discipler" value="Discipler: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="739.5" y="1040.0" width="75.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Announcement_treasurer" value="Treasurer: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="823.0" y="1040.0" width="78.9" height="22.0" as="geometry"/></mxCell><mxCell id="ac_Announcement_events" value="Events: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="909.9" y="1040.0" width="66.1" height="22.0" as="geometry"/></mxCell><mxCell id="n1_Bulletin" value="&lt;b style=&quot;font-size:11px&quot;&gt;Bulletin – in plain words&lt;/b&gt;&lt;br&gt;This week's church newspaper.&lt;br&gt;The Sunday bulletin PDF. All years, all months; read in the browser or&lt;br&gt;download." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1102.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_Bulletin" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Unique (branchId, weekOf).&lt;br&gt;• year and month are derived from weekOf and stored for fast filtering.&lt;br&gt;• A QStash job renders page 1 as a cover image and extracts text for&lt;br&gt;search.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1102.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_Bulletin" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Uploading every bulletin as a differently named file. Name = date, and&lt;br&gt;let the system derive the rest.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1102.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n1_Announcement" value="&lt;b style=&quot;font-size:11px&quot;&gt;Announcement – in plain words&lt;/b&gt;&lt;br&gt;A notice read out in church or sent during the week.&lt;br&gt;Two kinds in one table: SUNDAY announcements (audio + readable +&lt;br&gt;video, one per Sunday) and MIDWEEK ones (Friday youth fellowship,&lt;br&gt;men's retreat...)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1208.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n2_Announcement" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• kind = sunday requires serviceDate; kind = midweek requires eventAt&lt;br&gt;(CHECK).&lt;br&gt;• One sunday announcement per (branch, serviceDate).&lt;br&gt;• Midweek announcements auto-hide after expiresAt.&lt;br&gt;• Department leaders may draft midweek announcements; an Editor&lt;br&gt;approves.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1208.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n3_Announcement" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Two separate tables for sunday and midweek. They share 90% of their&lt;br&gt;columns; use one table with a kind column (single-table inheritance).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1208.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Bulletins are weekly PDFs by year/month. Announcements share ONE table with a "kind" column: sunday (audio+text+video) or midweek (text or PDF).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1340.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B30  ·  Tab: Bulletin and Announcement&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="departmentId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=1.5;endArrow=open;endFill=0;startArrow=none;startFill=0;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_Announcement" target="c_Department"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="334.0" y="750.5"/><mxPoint x="334.0" y="501.0"/></Array></mxGeometry></mxCell><mxCell id="edge0_s" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;fontColor=#64748B;labelBackgroundColor=none;" vertex="1" connectable="0" parent="edge0"><mxGeometry x="-0.86" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="edge0_d" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resi