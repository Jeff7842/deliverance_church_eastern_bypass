Color=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1132.0" width="63.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ConsentRecord_newmember" value="New member: S" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="121.7" y="1132.0" width="95.0" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ConsentRecord_super" value="Super: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="224.8" y="1132.0" width="61.7" height="22.0" as="geometry"/></mxCell><mxCell id="acc_NotificationLog" value="&lt;b&gt;Who may do what on NotificationLog   (C create, R read, U update, D delete, P publish, A approve, X export, S submit)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1194.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_NotificationLog_super" value="Super: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1222.0" width="61.7" height="22.0" as="geometry"/></mxCell><mxCell id="ac_NotificationLog_branch" value="Branch: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="119.7" y="1222.0" width="67.8" height="22.0" as="geometry"/></mxCell><mxCell id="n1_ContactMessage" value='&lt;b style="font-size:11px"&gt;ContactMessage – in plain words&lt;/b&gt;&lt;br&gt;A letter in the church mailbox.&lt;br&gt;The contact form submissions.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1284.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n2_ContactMessage" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Prayer and counselling topics route to a pastor, giving questions to the&lt;br&gt;Treasurer, "visit us" to the branch admin.&lt;br&gt;• Public form (name, e-mail/phone, topic, message). Rate-limited +&lt;br&gt;Turnstile.&lt;br&gt;• Routed to the Branch Admin inbox by chosen branch and topic; a copy&lt;br&gt;goes to e-mail.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1284.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n3_ContactMessage" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Only e-mailing the message and not saving it: if the e-mail bounces&lt;br&gt;the message is gone.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1284.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n1_ConsentRecord" value='&lt;b style="font-size:11px"&gt;ConsentRecord – in plain words&lt;/b&gt;&lt;br&gt;A receipt that says "yes, you may use cookies".&lt;br&gt;Proof that a visitor accepted (or declined) cookie categories on a given&lt;br&gt;policy version.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1416.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n2_ConsentRecord" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Necessary cookies need no consent; analytics (PostHog) only after&lt;br&gt;consent.&lt;br&gt;• Re-ask when policyVersion changes.&lt;br&gt;• Stores WHAT was agreed (cookies analytics, newsletter, new-member&lt;br&gt;data), WHEN, which policy version and the anonymised IP hash.&lt;br&gt;• Withdrawing consent adds a new row; old rows are never edited.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1416.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n3_ConsentRecord" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Overwriting the old consent row when someone changes their mind.&lt;br&gt;You lose the proof.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1416.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n1_NotificationLog" value='&lt;b style="font-size:11px"&gt;NotificationLog – in plain words&lt;/b&gt;&lt;br&gt;The post-office receipt book.&lt;br&gt;Every email/SMS the system tries to send, with the result. The first&lt;br&gt;place to look when "I never got the email".' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1548.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n2_NotificationLog" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• One row per e-mail/SMS attempt: template, to (hashed), provider id,&lt;br&gt;status, error.&lt;br&gt;• Used to answer "did the member get the certificate e-mail?".' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1548.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="n3_NotificationLog" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Logging the whole e-mail body with personal data. Log template + id&lt;br&gt;only.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1548.0" width="337.3" height="72.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;The three "paper trail" classes: what visitors wrote, what they agreed to, and what the system sent back.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1642.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B48  ·  Tab: Contact, consent, notification log&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object></root></mxGraphModel></diagram><diagram id="pg_B49" name="B49 Tab: Platform services (security, language, files)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="1371" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_AuthzService" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;«service»&lt;/i&gt;&lt;/font&gt;&lt;br&gt;AuthzService' style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#334155;strokeColor=#334155;swimlaneFillColor=#FFFFFF;strokeWidth=