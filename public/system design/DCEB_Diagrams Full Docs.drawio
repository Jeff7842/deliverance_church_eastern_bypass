0;" vertex="1" parent="1"><mxGeometry x="588.0" y="896.0" width="84.0" height="28.0" as="geometry"/></mxCell><mxCell id="r26c5" value="CRUA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4338CA;fillColor=#ECEBFA;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="672.0" y="896.0" width="84.0" height="28.0" as="geometry"/></mxCell><mxCell id="r26c6" value="CRU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#B91C1C;fillColor=#FBE9E9;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="756.0" y="896.0" width="84.0" height="28.0" as="geometry"/></mxCell><mxCell id="r26c7" value="CRUA" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#C2410C;fillColor=#FDEEE3;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="840.0" y="896.0" width="84.0" height="28.0" as="geometry"/></mxCell><mxCell id="r26c8" value="RU" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#15803D;fillColor=#E5F4EA;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="924.0" y="896.0" width="84.0" height="28.0" as="geometry"/></mxCell><mxCell id="r26c9" value="–" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#CBD5E1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1008.0" y="896.0" width="84.0" height="28.0" as="geometry"/></mxCell><mxCell id="r26c10" value="–" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#CBD5E1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1092.0" y="896.0" width="84.0" height="28.0" as="geometry"/></mxCell><mxCell id="r26c11" value="–" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#CBD5E1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=center;verticalAlign=middle;spacing=5;rounded=0;" vertex="1" parent="1"><mxGeometry x="1176.0" y="896.0" width="84.0" height="28.0" as="geometry"/></mxCell><mxCell id="tnote0" value="Letters: C create · R read · U update · D delete or archive · P publish · A approve or moderate · X export · S submit through a public form. A dash means no access at all. Coloured cells are the cells&lt;br&gt;that can change data; grey letters are read-only." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="948.0" width="900.0" height="44.0" as="geometry"/></mxCell><mxCell id="tnote1" value='These letters are not decoration. They are loaded into AuthzService, and a test fails the build if a role can do something this table does not allow (that is the "permission-matrix test" of gate G4).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1002.0" width="900.0" height="32.0" as="geometry"/></mxCell><mxCell id="tnote2" value="Scope matters too. Branch, Editor, Treasurer, Discipler and Events act only inside their own branch; Department Leader only inside their own department; Super Admin and Translator are global (see&lt;br&gt;RoleAssignment in B20 and B21)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;shape=note;size=12;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeome