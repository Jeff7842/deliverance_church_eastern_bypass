lapsible=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1018.0" width="1060.0" height="60.0" as="geometry"/></mxCell><mxCell id="ac_ServiceTime_visitor" value="Visitor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="50.0" y="1046.0" width="64.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ServiceTime_newmember" value="New member: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="122.3" y="1046.0" width="95.6" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ServiceTime_super" value="Super: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#E6E6F4;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="225.9" y="1046.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ServiceTime_branch" value="Branch: CRUD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#ECEBFA;strokeColor=#4338CA;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="317.2" y="1046.0" width="89.5" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ServiceTime_editor" value="Editor: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="414.7" y="1046.0" width="62.2" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ServiceTime_dept" value="Dept leader: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="484.9" y="1046.0" width="87.8" height="22.0" as="geometry"/></mxCell><mxCell id="ac_ServiceTime_events" value="Events: R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="580.7" y="1046.0" width="66.1" height="22.0" as="geometry"/></mxCell><mxCell id="n1_Branch" value='&lt;b style="font-size:11px"&gt;Branch – in plain words&lt;/b&gt;&lt;br&gt;One church building and its community.&lt;br&gt;A physical church location. Almost every other table carries a branchId,&lt;br&gt;so Branch is the most-referenced class in the system.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1108.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n2_Branch" value='&lt;b style="font-size:11px"&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Exactly one branch has isMain = true (partial unique index).&lt;br&gt;• Never hard-delete a branch; set isActive = false so history keeps its&lt;br&gt;meaning.&lt;br&gt;• Branch scope drives who may edit what (RoleAssignment.branchId).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1108.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n3_Branch" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Storing the branch NAME in other tables instead of its id. Rename&lt;br&gt;once and half your data is orphaned.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1108.0" width="337.3" height="84.0" as="geometry"/></mxCell><mxCell id="n1_ServiceTime" value='&lt;b style="font-size:11px"&gt;ServiceTime – in plain words&lt;/b&gt;&lt;br&gt;The timetable on the church door.&lt;br&gt;When each branch meets (Sunday services, midweek prayer, youth&lt;br&gt;night).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1214.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n2_ServiceTime" value="&lt;b style=&quot;font-size:11px&quot;&gt;Rules the code must keep&lt;/b&gt;&lt;br&gt;• Times are stored as local Nairobi time (no date), displayed with the&lt;br&gt;viewer's language.&lt;br&gt;• Many per branch (Sunday 1st/2nd service, Wednesday midweek,&lt;br&gt;Friday prayer).&lt;br&gt;• weekday 0-6 + local time + timezone Africa/Nairobi; the site never&lt;br&gt;stores &quot;9am&quot; as text." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="401.3" y="1214.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="n3_ServiceTime" value='&lt;b style="font-size:11px"&gt;Mistakes to avoid&lt;/b&gt;&lt;br&gt;• Typing service times as free text on the page: they go stale in 3&lt;br&gt;months. Keep them as data.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="762.7" y="1214.0" width="337.3" height="110.0" as="geometry"/></mxCell><mxCell id="gnote" value='&lt;b style="font-size:11px"&gt;How this group fits together&lt;/b&gt;&lt;br&gt;Branch is the most depended-on class in the system: 29 tables carry a branchId. That is how one website serves many churches.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#1B1B2F;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.3;shape=note;size=12;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="40.0" y="1346.0" width="1060.0" height="46.0" as="geometry"/></mxCell><mxCell id="bn_t" value='&lt;b style="font-size:19px"&gt;B22  ·  Tab: Branch and service times&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#000066;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="52.0" width="910.0" height="30.0" as="geometry"/></mxCell><mxCell id="bn_s" value="Class tabs (UML detail)   |   Attributes, parents, children, rules and mistakes   |   Phase 1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=-2;" vertex="1" parent="1"><mxGeometry x="40.0" y="82.0" width="910.0" height="30.0" as="geometry"/></mxCell><object id="bn_back" label='&lt;b style="font-size:11px"&gt;◀ Index&lt;/b&gt;' link="data:page/id,INDEX"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;fillColor=#000066;strokeColor=#000066;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="990.0" y="56.0" width="100.0" height="28.0" as="geometry"/></mxCell></object><mxCell id="edge0" value="homeBranchId" style="edgeStyle=orthogonalEdgeStyle;r