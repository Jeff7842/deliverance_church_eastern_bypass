/></mxCell><mxCell id="c_GivingChannel_a12" value="+ referenceInstructions: text {tr}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=10;fontFamily=Helvetica;fontColor=#1B1B2F;" vertex="1" parent="c_GivingChannel"><mxGeometry x="0.0" y="231.0" width="300.0" height="16.5" as="geometry"/></mxCell><mxCell id="shared_box" value="&lt;b&gt;Shared-kernel references (every role uses these, so no arrows are drawn)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#64748B;fillColor=#EEF1F5;strokeColor=#475569;strokeWidth=1.5;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="376.0" y="130.0" width="480.0" height="58.0" as="geometry"/></mxCell><mxCell id="sh_0" value="Branch ← branchId" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="386.0" y="158.0" width="109.6" height="20.0" as="geometry"/></mxCell><mxCell id="sh_1" value="User ← recordedBy" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="503.6" y="158.0" width="110.7" height="20.0" as="geometry"/></mxCell><mxCell id="sh_2" value="User ← voidedBy" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fontColor=#1B1B2F;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.3;align=center;verticalAlign=middle;spacing=2;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="622.4" y="158.0" width="100.7" height="20.0" as="geometry"/></mxCell><m